---
interface Props {
  title: string;
  slug: string;
  sku?: string;
  category: string;
  summary?: string;
  badge?: string;
  minOrderQty?: string;
  leadTime?: string;
  image?: string | null;
}

const {
  title,
  slug,
  sku,
  category,
  summary,
  badge = 'Custom OEM Available',
  minOrderQty = '50 PCS',
  leadTime = '7-15 Days',
  image = 'https://images.unsplash.com/photo-1581092160607-ee22621dd758?w=800&auto=format&fit=crop&q=80',
} = Astro.props;
---

<div class="group flex flex-col bg-slate-900 border border-slate-800 rounded-xl overflow-hidden hover:border-blue-500/50 hover:shadow-xl hover:shadow-blue-500/10 transition-all duration-300">
  <!-- Product Image Container -->
  <a href={`/products/${slug}`} class="relative aspect-[4/3] bg-slate-950 overflow-hidden block">
    <img
      src={image || 'https://images.unsplash.com/photo-1581092160607-ee22621dd758?w=800&auto=format&fit=crop&q=80'}
      alt={title}
      loading="lazy"
      class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent"></div>

    <!-- Badge Tag -->
    {badge && (
      <span class="absolute top-3 left-3 px-2.5 py-1 rounded-md text-[11px] font-semibold tracking-wide bg-blue-600/90 text-white shadow-md backdrop-blur-sm">
        {badge}
      </span>
    )}

    {sku && (
      <span class="absolute bottom-3 right-3 px-2 py-0.5 rounded text-[10px] font-mono font-medium bg-slate-900/90 text-slate-300 border border-slate-700/60 backdrop-blur-sm">
        {sku}
      </span>
    )}
  </a>

  <!-- Content Info -->
  <div class="p-5 flex-1 flex flex-col justify-between">
    <div>
      <div class="text-[11px] uppercase tracking-wider text-blue-400 font-semibold mb-1">
        {category}
      </div>
      <h3 class="font-bold text-base text-white group-hover:text-blue-400 transition-colors line-clamp-2 mb-2">
        <a href={`/products/${slug}`}>
          {title}
        </a>
      </h3>
      {summary && (
        <p class="text-xs text-slate-400 line-clamp-2 leading-relaxed mb-4">
          {summary}
        </p>
      )}
    </div>

    <!-- Commercial Terms & Action Button -->
    <div class="pt-4 border-t border-slate-800/80 mt-auto">
      <div class="grid grid-cols-2 gap-2 text-[11px] text-slate-400 mb-3">
        <div>
          <span class="text-slate-500 block">MOQ:</span>
          <span class="font-medium text-slate-200">{minOrderQty}</span>
        </div>
        <div>
          <span class="text-slate-500 block">Lead Time:</span>
          <span class="font-medium text-slate-200">{leadTime}</span>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <a
          href={`/products/${slug}`}
          class="flex-1 text-center py-2 px-3 rounded-lg text-xs font-semibold bg-slate-800 hover:bg-slate-700 text-slate-200 transition-colors border border-slate-700"
        >
          View Specs
        </a>
        <a
          href={`/contact?sku=${encodeURIComponent(sku || title)}#rfq`}
          class="py-2 px-3 rounded-lg text-xs font-semibold bg-blue-600 hover:bg-blue-500 text-white shadow-sm transition-colors"
        >
          Inquire RFQ
        </a>
      </div>
    </div>
  </div>
</div>
