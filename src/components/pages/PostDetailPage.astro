---
import Layout from '../../layouts/Layout.astro';
import { render, type CollectionEntry } from 'astro:content';
import { getStrings } from '../../i18n/strings';
import { lp, type Locale } from '../../i18n/config';

interface Props {
  locale: Locale;
  post: CollectionEntry<'posts'>;
}

const { locale, post } = Astro.props;
const t = getStrings(locale);
const D = t.pages.postDetail;

const { Content } = await render(post);

const {
  title,
  publishedDate,
  author = 'Naif',
  summary = '',
  coverImage,
} = post.data;

const formattedDate = publishedDate ? new Date(publishedDate).toISOString().slice(0, 10) : '';

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: summary || title,
  image: coverImage || undefined,
  datePublished: formattedDate,
  author: {
    '@type': 'Person',
    name: author,
    url: 'https://naif.is-a.dev',
  },
};
---

<Layout
  title={`${title} | ${D.metaTitleSuffix}`}
  description={summary || D.metaFallback}
  image={coverImage || undefined}
  locale={locale}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(articleSchema)} />

  <!-- Breadcrumbs Navigation -->
  <div class="border-b border-slate-800 bg-slate-900/60 py-3">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-xs text-slate-400">
        <a href={lp(locale, '/')} class="hover:text-blue-400 transition-colors">{t.common.crumbs.home}</a>
        <span>/</span>
        <a href={lp(locale, '/#articles')} class="hover:text-blue-400 transition-colors">{D.crumb}</a>
        <span>/</span>
        <span class="text-slate-200 truncate max-w-xs">{title}</span>
      </nav>
    </div>
  </div>

  <article class="py-12 sm:py-16 bg-slate-950">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Article Header -->
      <div class="mb-10">
        <div class="flex items-center gap-3 text-xs text-slate-400 font-mono mb-4">
          <span class="px-2 py-0.5 rounded bg-blue-500/10 text-blue-400 border border-blue-500/20 font-semibold">
            {D.badge}
          </span>
          <span>•</span>
          <span>{author}</span>
          {formattedDate && (
            <>
              <span>•</span>
              <time datetime={formattedDate}>{formattedDate}</time>
            </>
          )}
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight leading-tight mb-6">
          {title}
        </h1>

        {summary && (
          <p class="text-base sm:text-lg text-slate-300 leading-relaxed border-l-2 border-blue-500 pl-4 py-1 italic bg-blue-950/20 rounded-r-lg">
            {summary}
          </p>
        )}
      </div>

      <!-- Cover Image -->
      {coverImage && (
        <div class="mb-12 rounded-2xl overflow-hidden border border-slate-800 shadow-2xl aspect-video bg-slate-900">
          <img src={coverImage} alt={title} class="w-full h-full object-cover" />
        </div>
      )}

      <!-- Article Body Markdown Content -->
      <div class="prose prose-invert prose-slate max-w-none prose-headings:text-white prose-headings:font-bold prose-headings:tracking-tight prose-h2:text-2xl prose-h2:mt-10 prose-h2:mb-4 prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-3 prose-p:text-slate-300 prose-p:leading-relaxed prose-p:text-sm sm:prose-p:text-base prose-li:text-slate-300 prose-li:text-sm sm:prose-li:text-base prose-code:text-blue-300 prose-code:bg-slate-900 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:font-mono prose-code:text-xs prose-pre:bg-slate-900 prose-pre:border prose-pre:border-slate-800 prose-table:text-xs sm:prose-table:text-sm prose-th:text-slate-200 prose-th:bg-slate-900/80 prose-td:border-slate-800 prose-a:text-blue-400 hover:prose-a:underline">
        <Content />
      </div>

      <!-- Author Bio Footer Box -->
      <div class="mt-16 pt-8 border-t border-slate-800 bg-slate-900/60 rounded-2xl p-6 sm:p-8 flex flex-col sm:flex-row items-center gap-6">
        <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-blue-600 to-indigo-600 flex items-center justify-center text-white font-black text-2xl shadow-lg shrink-0">
          N
        </div>
        <div class="flex-1 text-center sm:text-left">
          <div class="font-bold text-white text-base">Naif</div>
          <div class="text-xs text-blue-400 font-mono mb-2">{D.authorRole}</div>
          <p class="text-xs text-slate-400 leading-relaxed">
            {D.authorBio}
          </p>
        </div>
        <a
          href={lp(locale, '/contact#rfq')}
          class="px-5 py-2.5 rounded-xl text-xs font-semibold text-white bg-blue-600 hover:bg-blue-500 shadow-md shadow-blue-600/30 transition-all hover:-translate-y-0.5 whitespace-nowrap"
        >
          {D.workWithMe}
        </a>
      </div>
    </div>
  </article>
</Layout>
