---
import Layout from '../../layouts/Layout.astro';
import { getStrings } from '../../i18n/strings';
import { lp, type Locale } from '../../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getStrings(locale);
const F = t.pages.faq;

const faqs = F.items;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.a + (f.detail ? ' ' + f.detail.join(' ') : ''),
    },
  })),
};
---

<Layout title={F.meta.title} description={F.meta.description} locale={locale}>
  <!-- Breadcrumb -->
  <div class="border-b border-slate-800 bg-slate-900/60 py-3">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-xs text-slate-400">
        <a href={lp(locale, '/')} class="hover:text-blue-400 transition-colors">{t.common.crumbs.home}</a>
        <span>/</span>
        <span class="text-blue-400">{t.common.crumbs.advisory}</span>
        <span>/</span>
        <span class="text-slate-200">{t.common.crumbs.faq}</span>
      </nav>
    </div>
  </div>

  <!-- Header -->
  <section class="py-14 sm:py-20 bg-slate-950 border-b border-slate-800 relative overflow-hidden">
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#1e293b0a_1px,transparent_1px),linear-gradient(to_bottom,#1e293b0a_1px,transparent_1px)] bg-[size:32px_32px]"></div>
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[250px] bg-blue-600/10 rounded-full blur-[130px] pointer-events-none"></div>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/20 text-xs font-semibold text-blue-400 mb-5">
        <span class="w-2 h-2 rounded-full bg-blue-400 animate-pulse"></span>
        <span>{F.header.badgePrefix} {faqs.length} {F.header.badgeSuffix}</span>
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight leading-tight mb-5">
        {F.header.headingLead} <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-indigo-300 to-sky-300">{F.header.headingHighlight}</span> {F.header.headingTail}
      </h1>
      <p class="text-sm sm:text-base text-slate-300 leading-relaxed max-w-2xl mx-auto">
        {F.header.lead}
      </p>
    </div>
  </section>

  <!-- FAQ List -->
  <section class="py-16 sm:py-20 bg-slate-950">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="space-y-4">
        {faqs.map((f, i) => (
          <details class="group bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden hover:border-blue-500/40 transition-colors" open={i === 0}>
            <summary class="flex items-start justify-between gap-4 p-5 sm:p-6 cursor-pointer list-none select-none">
              <div class="flex items-start gap-3.5">
                <span class="shrink-0 w-7 h-7 rounded-lg bg-blue-500/10 border border-blue-500/20 text-blue-400 font-mono text-xs font-bold flex items-center justify-center mt-0.5">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span class="text-sm sm:text-base font-bold text-white leading-snug group-hover:text-blue-300 transition-colors">
                  {f.q}
                </span>
              </div>
              <svg class="w-5 h-5 text-slate-500 shrink-0 mt-0.5 group-open:rotate-45 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v14M5 12h14" />
              </svg>
            </summary>
            <div class="px-5 sm:px-6 pb-5 sm:pb-6 pl-[4.25rem] sm:pl-[4.5rem]">
              <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">{f.a}</p>
              {f.detail && f.detail.length > 0 && (
                <ul class="mt-4 space-y-2">
                  {f.detail.map((d) => (
                    <li class="flex items-start gap-2.5 text-xs text-slate-400 leading-relaxed">
                      <span class="text-blue-400 font-bold shrink-0 mt-0.5">→</span>
                      <span>{d}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </details>
        ))}
      </div>

      <!-- Still Have Questions CTA -->
      <div class="mt-12 bg-gradient-to-br from-blue-950/50 to-slate-900 border border-blue-500/20 rounded-2xl p-7 sm:p-9 text-center">
        <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight mb-2">{F.cta.heading}</h2>
        <p class="text-xs sm:text-sm text-slate-400 max-w-xl mx-auto mb-6 leading-relaxed">
          {F.cta.lead}
        </p>
        <div class="flex flex-wrap items-center justify-center gap-4">
          <a
            href={lp(locale, '/contact#rfq')}
            class="px-6 py-3.5 rounded-xl font-semibold text-sm bg-blue-600 hover:bg-blue-500 text-white shadow-lg shadow-blue-600/30 transition-all hover:-translate-y-0.5"
          >
            {t.common.cta.askQuestion}
          </a>
          <a
            href={lp(locale, '/services')}
            class="px-6 py-3.5 rounded-xl font-semibold text-sm bg-slate-900 hover:bg-slate-800 text-slate-200 border border-slate-800 transition-colors"
          >
            {t.common.cta.compareTiers}
          </a>
        </div>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</Layout>
