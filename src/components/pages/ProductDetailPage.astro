---
import Layout from '../../layouts/Layout.astro';
import RfqForm from '../RfqForm.astro';
import { render, type CollectionEntry } from 'astro:content';
import { getStrings } from '../../i18n/strings';
import { lp, type Locale } from '../../i18n/config';

interface Props {
  locale: Locale;
  product: CollectionEntry<'products'>;
}

const { locale, product } = Astro.props;
const t = getStrings(locale);
const D = t.pages.productDetail;

const { Content } = await render(product);

const {
  title,
  sku,
  category,
  categoryLabel,
  summary,
  badge,
  minOrderQty,
  leadTime,
  image,
  specs = [],
  features = [],
} = product.data;

// Generate Schema.org JSON-LD
const projectSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: title,
  applicationCategory: category,
  operatingSystem: 'Shopify OS2.0, Cloudflare Edge, Jamstack',
  softwareVersion: sku || '1.0',
  description: summary || title,
  author: {
    '@type': 'Person',
    name: 'Naif',
    url: 'https://naif.is-a.dev',
  },
};
---

<Layout
  title={`${title} | DTC Growth Architecture | Naif`}
  description={summary || `Technical deep-dive, conversion benchmarks, and architecture decisions for ${title}.`}
  image={image || undefined}
  locale={locale}
>
  <!-- Inject Schema.org JSON-LD -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify(projectSchema)} />

  <!-- Breadcrumbs Navigation -->
  <div class="border-b border-slate-800 bg-slate-900/60 py-3">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-xs text-slate-400">
        <a href={lp(locale, '/')} class="hover:text-blue-400 transition-colors">{t.common.crumbs.home}</a>
        <span>/</span>
        <a href={lp(locale, '/products')} class="hover:text-blue-400 transition-colors">{t.common.crumbs.caseStudies}</a>
        <span>/</span>
        <span class="text-blue-400 capitalize">{(categoryLabel || category).replace('-', ' ')}</span>
        <span>/</span>
        <span class="text-slate-200 truncate max-w-xs">{title}</span>
      </nav>
    </div>
  </div>

  <div class="py-12 sm:py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Top Grid: Stage + Summary -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-start mb-16">
      <!-- Left: Thumbnail Hero Stage (5 cols) -->
      <div class="lg:col-span-5">
        <div class="sticky top-24 bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden shadow-2xl p-2">
          <div class="aspect-video sm:aspect-square rounded-xl overflow-hidden bg-slate-950 relative">
            <img
              src={image || 'https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=800&auto=format&fit=crop&q=80'}
              alt={title}
              class="w-full h-full object-cover"
            />
            {badge && (
              <span class="absolute top-4 left-4 px-3 py-1 rounded-md text-xs font-semibold bg-blue-600/90 text-white backdrop-blur-sm shadow-md">
                {badge}
              </span>
            )}
          </div>
          <div class="p-3 text-center text-xs text-slate-400 font-mono">
            {D.footerNote}
          </div>
        </div>
      </div>

      <!-- Right: Technical Summary & Actions (7 cols) -->
      <div class="lg:col-span-7 space-y-6">
        <div>
          <div class="flex items-center gap-3 mb-2">
            <span class="text-xs uppercase tracking-wider text-blue-400 font-semibold">{(categoryLabel || category).replace('-', ' ')}</span>
            {sku && (
              <span class="text-xs font-mono px-2 py-0.5 rounded bg-slate-800 text-slate-300 border border-slate-700">
                {sku}
              </span>
            )}
          </div>
          <h1 class="text-2xl sm:text-3xl font-black text-white tracking-tight leading-snug">
            {title}
          </h1>
        </div>

        {summary && (
          <p class="text-sm sm:text-base text-slate-300 leading-relaxed border-l-2 border-blue-500 pl-4 py-1">
            {summary}
          </p>
        )}

        <!-- Quick Architecture Metrics Card -->
        <div class="bg-slate-900/90 border border-slate-800 rounded-xl p-5 grid grid-cols-2 sm:grid-cols-3 gap-4">
          <div>
            <span class="text-xs text-slate-500 block mb-0.5">{D.stackLabel}</span>
            <span class="text-sm font-semibold text-white">{minOrderQty}</span>
          </div>
          <div>
            <span class="text-xs text-slate-500 block mb-0.5">{D.benchmarkLabel}</span>
            <span class="text-sm font-semibold text-emerald-400">{leadTime}</span>
          </div>
          <div>
            <span class="text-xs text-slate-500 block mb-0.5">{D.targetLabel}</span>
            <span class="text-sm font-semibold text-blue-300">{D.targetValue}</span>
          </div>
        </div>

        <!-- Key Engineering Highlights -->
        {features.length > 0 && (
          <div class="space-y-2">
            <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-400">{D.highlightsHeading}</h3>
            <ul class="space-y-2 text-xs sm:text-sm text-slate-300">
              {features.map((feat) => (
                <li class="flex items-start gap-2">
                  <svg class="w-4 h-4 text-blue-400 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>{feat}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- Inquiry Action Trigger -->
        <div class="pt-4 flex flex-wrap items-center gap-4">
          <a
            href="#inquiry-form-section"
            class="px-6 py-3 rounded-xl font-semibold text-sm bg-blue-600 hover:bg-blue-500 text-white shadow-lg shadow-blue-600/30 transition-all hover:-translate-y-0.5 flex items-center gap-2"
          >
            <span>{D.inquire}</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
          <a
            href={lp(locale, '/products')}
            class="px-4 py-3 rounded-xl font-semibold text-xs bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 transition-colors"
          >
            {D.back}
          </a>
        </div>
      </div>
    </div>

    <!-- Technical Specifications Matrix -->
    {specs.length > 0 && (
      <div class="mb-16">
        <div class="border-b border-slate-800 pb-3 mb-6">
          <h2 class="text-xl font-bold text-white tracking-tight">{D.specsHeading}</h2>
        </div>
        <div class="bg-slate-900 border border-slate-800 rounded-xl overflow-hidden">
          <table class="w-full text-left text-xs sm:text-sm">
            <tbody class="divide-y divide-slate-800">
              {specs.map((item, index) => (
                <tr class={index % 2 === 0 ? 'bg-slate-900' : 'bg-slate-950/40'}>
                  <td class="py-3.5 px-6 font-semibold text-slate-300 w-1/3 sm:w-1/4 border-r border-slate-800">
                    {item.label}
                  </td>
                  <td class="py-3.5 px-6 text-slate-200 font-mono">
                    {item.value}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    )}

    <!-- Detailed Case Study Markdown Content -->
    <div class="mb-20">
      <div class="border-b border-slate-800 pb-3 mb-6">
        <h2 class="text-xl font-bold text-white tracking-tight">{D.walkthroughHeading}</h2>
      </div>
      <div class="prose prose-invert prose-blue max-w-none text-slate-300 text-sm sm:text-base leading-relaxed">
        <Content />
      </div>
    </div>

    <!-- Attached Inquiry Form -->
    <div id="inquiry-form-section" class="pt-8 border-t border-slate-800">
      <div class="max-w-3xl mx-auto">
        <RfqForm locale={locale} presetSku={`${sku ? sku + ' - ' : ''}${title}`} />
      </div>
    </div>
  </div>
</Layout>
