---
import Layout from '../../layouts/Layout.astro';
import { getStrings } from '../../i18n/strings';
import { lp, type Locale } from '../../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getStrings(locale);
const R = t.pages.resources;

const categoryOrder = ['performance', 'edge', 'diagnostics', 'intelligence'] as const;
type CategoryKey = (typeof categoryOrder)[number];
const categoryLabel = (cat: string) =>
  R.categories[cat as CategoryKey] ?? R.categories.performance;
const resources = R.entries;
const tags: Record<string, string[]> = {
  psi: ['Core Web Vitals', 'Lighthouse', 'CrUX'],
  wpt: ['Waterfall', 'Filmstrip', '4G Throttling'],
  urlscan: ['Security Sandbox', 'HTTP Tracing', 'DOM Audit'],
  gtmetrix: ['Synthetic Audits', 'Speed Index', 'Page Timings'],
  yellowlab: ['Code Quality', 'DOM Depth', 'CSS Bloat'],
  speedvitals: ['Edge TTFB', '35+ PoPs', 'Latency'],
  cfworkers: ['Edge Compute', 'V8 Isolates', 'Sub-5ms Start'],
  astro: ['Islands Architecture', 'Zero-JS', 'Jamstack'],
  resend: ['Transactional Email', 'React Email', 'High Deliverability'],
  upstash: ['Serverless Redis', 'Kafka', 'QStash'],
  turso: ['Distributed SQLite', 'Edge DB', 'libSQL'],
  keystatic: ['Git-backed CMS', 'Markdown/MDX', 'Zero DB'],
  mailtester: ['Spam Score', 'DKIM/SPF', 'SpamAssassin'],
  mxtoolbox: ['MX Lookup', 'DNS Health', 'Blacklist Check'],
  ssllabs: ['TLS Ciphers', 'A+ Grade', 'Cert Chain'],
  securityheaders: ['CSP', 'HSTS', 'X-Frame-Options'],
  dnsviz: ['DNSSEC', 'Visual Graph', 'Delegation Chain'],
  bgpview: ['Autonomous System (ASN)', 'BGP Routing', 'IP Transit'],
  importyeti: ['US Bill of Lading', 'Supply Chain', 'Sea Shipments'],
  metalib: ['Ad Creatives', 'Competitor Spying', 'FB/IG Campaigns'],
  adstransparency: ['Google Search Ads', 'YouTube Ads', 'Display'],
  wipo: ['Trademarks', 'Madrid System', 'IP Protection'],
  builtwith: ['Tech Stack Lookup', 'CMS Profiling', 'Tracking Pixels'],
  similarweb: ['Traffic Estimates', 'Referral Channels', 'Keywords'],
};
---

<Layout title={R.meta.title} description={R.meta.description} locale={locale}>
  <!-- Breadcrumb -->
  <div class="border-b border-slate-800 bg-slate-900/60 py-3">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-xs text-slate-400">
        <a href={lp(locale, '/')} class="hover:text-blue-400 transition-colors">{t.common.crumbs.home}</a>
        <span>/</span>
        <span class="text-blue-400">{t.common.nav.resources}</span>
        <span>/</span>
        <span class="text-slate-200">{t.common.footer.resourcesLink}</span>
      </nav>
    </div>
  </div>

  <section class="py-12 sm:py-16 lg:py-20 bg-slate-950 relative overflow-hidden">
    <!-- Subtle Background Highlights -->
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#1e293b0a_1px,transparent_1px),linear-gradient(to_bottom,#1e293b0a_1px,transparent_1px)] bg-[size:32px_32px]"></div>
    <div class="absolute top-1/4 left-1/3 w-[600px] h-[300px] bg-blue-600/10 rounded-full blur-[140px] pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <!-- Section Header -->
      <div class="max-w-3xl mb-12">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/20 text-xs font-semibold text-blue-400 mb-4">
          <span class="w-2 h-2 rounded-full bg-blue-400"></span>
          <span>{R.badge}</span>
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight leading-tight mb-4">
          {R.headingLead} <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-indigo-300 to-sky-300">{R.headingHighlight}</span>
        </h1>
        <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
          {R.lead}
        </p>
      </div>

      <!-- Category Filter Pills -->
      <div class="flex flex-wrap items-center gap-2 mb-10 pb-4 border-b border-slate-800" id="filter-container">
        <button
          type="button"
          data-category="all"
          class="filter-btn active px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-blue-600 text-white shadow-sm transition-all"
        >
          {R.allResources} ({resources.length})
        </button>
        {categoryOrder.map((cat) => (
          <button
            type="button"
            data-category={cat}
            class="filter-btn px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-slate-900 text-slate-400 hover:text-white border border-slate-800 hover:border-slate-700 transition-all"
          >
            {categoryLabel(cat)} ({resources.filter((r) => r.category === cat).length})
          </button>
        ))}
      </div>

      <!-- Resources Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="resources-grid">
        {resources.map((item) => (
          <div
            class="resource-card bg-slate-900 border border-slate-800 hover:border-blue-500/40 rounded-2xl p-6 flex flex-col justify-between transition-all duration-200 hover:-translate-y-1 shadow-lg group"
            data-category={item.category}
          >
            <div>
              <!-- Header Bar -->
              <div class="flex items-start justify-between gap-3 mb-3">
                <span class="text-[10px] font-mono uppercase tracking-wider px-2 py-0.5 rounded bg-slate-950 text-slate-400 border border-slate-800">
                  {categoryLabel(item.category)}
                </span>
                <a
                  href={item.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={R.openInNewTab.replace('{name}', item.name)}
                  class="text-slate-500 group-hover:text-blue-400 transition-colors p-1"
                >
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </a>
              </div>

              <!-- Title & Domain -->
              <h2 class="text-base font-bold text-white group-hover:text-blue-300 transition-colors">
                <a href={item.url} target="_blank" rel="noopener noreferrer" class="hover:underline">
                  {item.name}
                </a>
              </h2>
              <div class="text-[11px] font-mono text-slate-500 mb-3">{item.domain}</div>

              <!-- Description -->
              <p class="text-xs text-slate-400 leading-relaxed mb-4">
                {item.description}
              </p>
            </div>

            <!-- Tags & Direct Outbound Link -->
            <div class="pt-4 border-t border-slate-800/80 flex items-center justify-between gap-2">
              <div class="flex flex-wrap gap-1">
                {(tags[item.key] || []).map((tag) => (
                  <span class="text-[10px] px-1.5 py-0.5 rounded bg-slate-950 text-slate-400 font-mono">
                    #{tag}
                  </span>
                ))}
              </div>
              <a
                href={item.url}
                target="_blank"
                rel="noopener noreferrer"
                class="text-[10px] font-semibold text-blue-400 hover:text-blue-300 transition-colors whitespace-nowrap"
              >
                {R.launch} ↗
              </a>
            </div>
          </div>
        ))}
      </div>

      <!-- Bottom Advisory Card -->
      <div class="mt-16 bg-slate-900 border border-slate-800 rounded-2xl p-8 flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="max-w-2xl">
          <div class="text-xs font-mono uppercase text-blue-400 font-bold mb-1">Architecture Diagnostic Service</div>
          <h3 class="text-xl font-bold text-white mb-2">{R.diagnosticCta.heading}</h3>
          <p class="text-xs text-slate-400 leading-relaxed">
            {R.diagnosticCta.body}
          </p>
        </div>
        <a
          href={lp(locale, '/contact#rfq')}
          class="px-6 py-3 rounded-xl font-semibold text-xs text-white bg-blue-600 hover:bg-blue-500 shadow-md shadow-blue-600/30 transition-all hover:-translate-y-0.5 whitespace-nowrap"
        >
          {R.diagnosticCta.button} →
        </a>
      </div>
    </div>
  </section>
</Layout>

<script is:inline>
  function initFilters() {
    const filterButtons = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('.resource-card');

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const cat = btn.getAttribute('data-category');

        filterButtons.forEach((b) => {
          b.classList.remove('bg-blue-600', 'text-white');
          b.classList.add('bg-slate-900', 'text-slate-400');
        });
        btn.classList.remove('bg-slate-900', 'text-slate-400');
        btn.classList.add('bg-blue-600', 'text-white');

        cards.forEach((card) => {
          const cardCat = card.getAttribute('data-category');
          if (cat === 'all' || cardCat === cat) {
            (card).style.display = 'flex';
          } else {
            (card).style.display = 'none';
          }
        });
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFilters);
  } else {
    initFilters();
  }
</script>
