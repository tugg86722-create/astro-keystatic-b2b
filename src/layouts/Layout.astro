---
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'Naif | DTC eCommerce Operator & Full-Funnel Growth Architect',
  description = 'Personal growth & systems portfolio of Naif. Specializing in high-ticket DTC Shopify/Jamstack storefronts, Meta ad landing page CRO, automated Klaviyo retention, and sub-second edge commerce.',
  image = 'https://images.unsplash.com/photo-1555066931-4365d14bab8c?w=1200&auto=format&fit=crop&q=80',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://naif.is-a.dev');
---

<!doctype html>
<html lang="en" class="bg-slate-950 text-slate-100 antialiased selection:bg-blue-600 selection:text-white">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- Developer Schema.org JSON-LD -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Naif",
        "jobTitle": "DTC eCommerce Operator & Growth Architect",
        "url": "https://naif.is-a.dev",
        "sameAs": [
          "https://github.com/tugg86722-create"
        ],
        "knowsAbout": [
          "DTC eCommerce",
          "Shopify Architecture",
          "Conversion Rate Optimization (CRO)",
          "Meta Ads Traffic",
          "Klaviyo Lifecycle Automation",
          "Chargeback Defense",
          "Sub-Second Web Performance",
          "Jamstack"
        ]
      }
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-slate-950 text-slate-200">
    <!-- Top Status Bar -->
    <div class="bg-blue-900/30 border-b border-blue-500/20 text-xs py-1.5 px-4 text-center text-blue-200 flex items-center justify-center gap-4">
      <span class="inline-flex items-center gap-1.5 font-medium">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        Status: Available for DTC Brand Architecture, CRO & Growth Advisory
      </span>
      <span class="hidden md:inline text-blue-400/60">|</span>
      <span class="hidden md:inline font-mono text-[11px] text-blue-300">naif.is-a.dev</span>
    </div>

    <!-- Main Navigation Header -->
    <header class="sticky top-0 z-40 w-full backdrop-blur-md bg-slate-950/80 border-b border-slate-800">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-18 flex items-center justify-between">
        <!-- Developer Brand Logo -->
        <a href="/" class="flex items-center gap-3 group">
          <div class="w-10 h-10 rounded-lg bg-gradient-to-br from-blue-600 via-indigo-600 to-sky-500 flex items-center justify-center text-white font-black text-xl shadow-lg shadow-blue-500/20 group-hover:scale-105 transition-transform">
            N
          </div>
          <div>
            <div class="font-bold text-lg text-white tracking-tight flex items-center gap-1.5">
              NAIF
              <span class="text-[10px] px-1.5 py-0.5 rounded bg-blue-500/10 text-blue-400 border border-blue-500/20 font-mono font-semibold">DTC</span>
            </div>
            <div class="text-[11px] text-slate-400 tracking-wider uppercase font-medium">DTC Operator & Growth Architect</div>
          </div>
        </a>

        <!-- Desktop Navigation -->
        <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-slate-300">
          <a href="/" class="hover:text-blue-400 transition-colors">Home</a>
          <a href="/products" class="hover:text-blue-400 transition-colors">Case Studies</a>
          <a href="/services" class="hover:text-blue-400 transition-colors">Services & Pricing</a>
          <a href="/tools" class="hover:text-blue-400 transition-colors flex items-center gap-1">
            <span>Tools</span>
            <span class="text-[9px] px-1 py-0.2 rounded bg-rose-500/10 text-rose-400 font-mono font-semibold border border-rose-500/20">NEW</span>
          </a>
          <a href="/resources" class="hover:text-blue-400 transition-colors">Resources</a>
          <a href="/about" class="hover:text-blue-400 transition-colors">About</a>
        </nav>

        <!-- CTA Action Button & Mobile Menu Toggle -->
        <div class="flex items-center gap-3">
          <a
            href="/contact#rfq"
            class="hidden sm:inline-flex items-center justify-center px-4 py-2 rounded-lg text-sm font-semibold text-white bg-blue-600 hover:bg-blue-500 shadow-md shadow-blue-600/30 transition-all hover:-translate-y-0.5"
          >
            Start a Project
          </a>

          <!-- Mobile Quick Nav Buttons -->
          <div class="flex md:hidden items-center gap-2 text-xs">
            <a href="/tools" class="px-2.5 py-1.5 rounded-lg bg-slate-900 border border-slate-800 text-blue-400 font-medium">Tools</a>
            <a href="/resources" class="px-2.5 py-1.5 rounded-lg bg-slate-900 border border-slate-800 text-slate-300 font-medium">Hub</a>
            <a href="/about" class="px-2.5 py-1.5 rounded-lg bg-slate-900 border border-slate-800 text-slate-300 font-medium">About</a>
          </div>
        </div>
      </div>
    </header>

    <!-- Main Page Content -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Global Footer -->
    <footer class="bg-slate-900 border-t border-slate-800 text-slate-400 text-sm">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-10">
          <!-- Col 1: Bio -->
          <div class="space-y-4">
            <div class="flex items-center gap-2">
              <div class="w-8 h-8 rounded bg-blue-600 flex items-center justify-center text-white font-bold text-base">N</div>
              <span class="font-bold text-white text-base tracking-tight">NAIF // DTC</span>
            </div>
            <p class="text-xs text-slate-400 leading-relaxed">
              DTC eCommerce Operator & Full-Funnel Growth Architect. Bridging the gap between high-ticket brand storytelling, storefront engineering, and Meta/Google ad profitability.
            </p>
            <div class="flex items-center gap-2 text-xs text-slate-500 font-mono">
              <span>Shopify</span> • <span>Liquid</span> • <span>Klaviyo</span> • <span>Meta Ads</span> • <span>Astro Edge</span>
            </div>
          </div>

          <!-- Col 2: Projects & Systems -->
          <div>
            <h4 class="text-xs font-semibold uppercase tracking-wider text-slate-200 mb-3">DTC Systems & Case Studies</h4>
            <ul class="space-y-2 text-xs">
              <li><a href="/products" class="hover:text-blue-400 transition-colors">All Architecture Case Studies</a></li>
              <li><a href="/products/sub-second-jamstack-edge-commerce-platform" class="hover:text-blue-400 transition-colors">High-Ticket Jewelry Storefront</a></li>
              <li><a href="/products/event-driven-serverless-dispatch-gateway" class="hover:text-blue-400 transition-colors">Ad Landing Page & Click-Loss CRO</a></li>
              <li><a href="/products/zero-overhead-web-telemetry-engine" class="hover:text-blue-400 transition-colors">Klaviyo Retention & Chargeback Shield</a></li>
            </ul>
          </div>

          <!-- Col 3: Navigation & Tools -->
          <div>
            <h4 class="text-xs font-semibold uppercase tracking-wider text-slate-200 mb-3">Navigation & Tools</h4>
            <ul class="space-y-2 text-xs">
              <li><a href="/services" class="hover:text-blue-400 transition-colors">Services, Pricing & Fit Check</a></li>
              <li><a href="/about" class="hover:text-blue-400 transition-colors">About & Strategic Pillars</a></li>
              <li><a href="/tools" class="hover:text-blue-400 transition-colors">Ad ROI & Latency Calculator</a></li>
              <li><a href="/tools/click-loss-auditor" class="hover:text-blue-400 transition-colors">Click-Loss Auditor</a></li>
              <li><a href="/tools/chargeback-scorecard" class="hover:text-blue-400 transition-colors">Chargeback Risk Scorecard</a></li>
              <li><a href="/resources" class="hover:text-blue-400 transition-colors">Curated Operator & Trade Hub</a></li>
              <li><a href="/#articles" class="hover:text-blue-400 transition-colors">Technical Whitepapers</a></li>
              <li><a href="/faq" class="hover:text-blue-400 transition-colors">FAQ</a></li>
              <li><a href="/contact" class="hover:text-blue-400 transition-colors">Growth Advisory & Audit RFQ</a></li>
            </ul>
          </div>

          <!-- Col 4: Contact -->
          <div class="space-y-3">
            <h4 class="text-xs font-semibold uppercase tracking-wider text-slate-200 mb-2">Advisory & Inquiries</h4>
            <div class="text-xs space-y-1.5 text-slate-300">
              <p class="flex items-center gap-2">
                <span class="text-slate-500">Email:</span>
                <a href="mailto:dewellsmell@gmail.com" class="text-blue-400 hover:underline">dewellsmell@gmail.com</a>
              </p>
              <p class="flex items-center gap-2">
                <span class="text-slate-500">GitHub:</span>
                <a href="https://github.com/tugg86722-create" target="_blank" rel="noreferrer" class="text-blue-400 hover:underline">tugg86722-create</a>
              </p>
              <p class="text-slate-400 text-[11px] pt-1">
                Open for high-ticket DTC architecture audits, conversion rate optimization, and Klaviyo lifecycle retention contracts.
              </p>
            </div>
          </div>
        </div>

        <div class="mt-12 pt-6 border-t border-slate-800 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 gap-4">
          <p>© {new Date().getFullYear()} Naif. Engineered with Astro, Tailwind CSS & Cloudflare Edge.</p>
          <div class="flex items-center gap-4">
            <span class="text-slate-500">Domain: <strong class="text-blue-400">naif.is-a.dev</strong></span>
          </div>
        </div>
      </div>
    </footer>
    <Analytics />
  </body>
</html>
