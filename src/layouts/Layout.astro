---
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import { getStrings } from '../i18n/strings';
import { DEFAULT_LOCALE, LOCALE_META, LOCALES, lp, hreflangPath, type Locale } from '../i18n/config';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  locale?: Locale;
}

const {
  title,
  description,
  image = 'https://images.unsplash.com/photo-1555066931-4365d14bab8c?w=1200&auto=format&fit=crop&q=80',
  locale = DEFAULT_LOCALE,
} = Astro.props;

const t = getStrings(locale);
const meta = LOCALE_META[locale];

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://naif.is-a.dev');

// Strip the locale prefix from the current pathname so alternate links can be
// generated for every locale against the same logical page.
const rawPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const basePath =
  locale === DEFAULT_LOCALE ? rawPath : rawPath.replace(new RegExp(`^/${locale}(?=/|$)`), '') || '/';

const siteOrigin = Astro.site || 'https://naif.is-a.dev';
const alternates = LOCALES.map((l) => ({
  locale: l,
  href: new URL(hreflangPath(l, basePath), siteOrigin).toString(),
}));
---

<!doctype html>
<html lang={meta.htmlLang} class="bg-slate-950 text-slate-100 antialiased selection:bg-blue-600 selection:text-white">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title || t.pages.home.meta.title}</title>
    <meta name="description" content={description || t.pages.home.meta.description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- hreflang alternates -->
    {alternates.map((a) => (
      <link rel="alternate" hreflang={LOCALE_META[a.locale].htmlLang} href={a.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(hreflangPath(DEFAULT_LOCALE, basePath), siteOrigin).toString()} />

    <!-- Open Graph / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title || t.pages.home.meta.title} />
    <meta property="og:description" content={description || t.pages.home.meta.description} />
    <meta property="og:image" content={image} />
    <meta property="og:locale" content={meta.ogLocale} />
    {LOCALES.filter((l) => l !== locale).map((l) => (
      <meta property="og:locale:alternate" content={LOCALE_META[l].ogLocale} />
    ))}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title || t.pages.home.meta.title} />
    <meta name="twitter:description" content={description || t.pages.home.meta.description} />
    <meta name="twitter:image" content={image} />

    <!--
      Browser-language detection.
      Runs synchronously in <head> so the visitor never sees the English page
      flash before we move them. Client-side only — crawlers get the full
      English HTML with correct canonical/hreflang, so SEO is unaffected.
      A stored choice always wins, so this fires at most once per visitor.
    -->
    <script is:inline>
      (function () {
        var KEY = 'wb-locale';
        var ALL = ['en', 'zh', 'es', 'fr', 'de', 'ja'];
        var SUPPORTED = ['zh', 'es', 'fr', 'de', 'ja'];
        var html = document.documentElement;
        var redirecting = false;

        // Hide the body while we decide, so an incoming visitor never sees the
        // English page flash before we move them. Removed again below if we
        // are staying put (same tick, so nothing is ever painted).
        html.classList.add('wb-lang-pending');

        /**
         * Rewrite the current path to the same logical page in `locale`.
         * English lives at the root; every other locale sits under its prefix.
         */
        function pathForLocale(locale) {
          var path = location.pathname.replace(/\/+$/, '');
          // Drop whatever locale prefix the current URL carries.
          var parts = path.split('/').filter(Boolean);
          if (parts.length && SUPPORTED.indexOf(parts[0]) !== -1) parts.shift();
          var rest = parts.length ? '/' + parts.join('/') : '';
          var prefix = locale === 'en' ? '' : '/' + locale;
          return prefix + (rest ? rest + '/' : '/') + location.search + location.hash;
        }

        function go(locale) {
          localStorage.setItem(KEY, locale);
          redirecting = true;
          location.replace(pathForLocale(locale));
        }

        try {
          var stored = localStorage.getItem(KEY);
          var pageLocale = (html.getAttribute('lang') || 'en').toLowerCase().split('-')[0];

          if (stored && ALL.indexOf(stored) !== -1) {
            // A remembered choice always wins — take the visitor back to the
            // language they picked, even if they landed on the English page.
            if (stored !== pageLocale) go(stored);
          } else if (pageLocale && pageLocale !== 'en') {
            // Arrived directly on a translated page — remember it, don't bounce.
            localStorage.setItem(KEY, pageLocale);
          } else {
            var langs =
              (navigator.languages && navigator.languages.length
                ? navigator.languages
                : [navigator.language || '']) || [];
            var target = null;
            for (var i = 0; i < langs.length; i++) {
              var code = String(langs[i] || '').toLowerCase().split('-')[0];
              if (code === 'en') break; // English is the top preference — stay put.
              if (SUPPORTED.indexOf(code) !== -1) {
                target = code;
                break;
              }
            }
            if (target) go(target);
          }

          // Remember an explicit pick from the switcher.
          document.addEventListener('click', function (e) {
            var el = e.target && e.target.closest ? e.target.closest('[data-wb-locale]') : null;
            if (el) {
              try {
                localStorage.setItem(KEY, el.getAttribute('data-wb-locale'));
              } catch (err) {}
            }
          });
        } catch (e) {}

        if (!redirecting) html.classList.remove('wb-lang-pending');
      })();
    </script>

    <!-- Developer Schema.org JSON-LD -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Naif",
        "jobTitle": "DTC eCommerce Operator & Growth Architect",
        "url": "https://naif.is-a.dev",
        "sameAs": [
          "https://github.com/tugg86722-create"
        ],
        "knowsAbout": [
          "DTC eCommerce",
          "Shopify Architecture",
          "Conversion Rate Optimization (CRO)",
          "Meta Ads Traffic",
          "Klaviyo Lifecycle Automation",
          "Chargeback Defense",
          "Sub-Second Web Performance",
          "Jamstack"
        ]
      }
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-slate-950 text-slate-200">
    <!-- Top Status Bar -->
    <div class="bg-blue-900/30 border-b border-blue-500/20 text-xs py-1.5 px-4 text-center text-blue-200 flex items-center justify-center gap-4">
      <span class="inline-flex items-center gap-1.5 font-medium">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        {t.common.statusBar}
      </span>
      <span class="hidden md:inline text-blue-400/60">|</span>
      <span class="hidden md:inline font-mono text-[11px] text-blue-300">naif.is-a.dev</span>
    </div>

    <!-- Main Navigation Header -->
    <header class="sticky top-0 z-40 w-full backdrop-blur-md bg-slate-950/80 border-b border-slate-800">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-18 flex items-center justify-between">
        <!-- Developer Brand Logo -->
        <a href={lp(locale, '/')} class="flex items-center gap-3 group min-w-0 shrink">
          <div class="w-10 h-10 rounded-lg bg-gradient-to-br from-blue-600 via-indigo-600 to-sky-500 flex items-center justify-center text-white font-black text-xl shadow-lg shadow-blue-500/20 group-hover:scale-105 transition-transform">
            N
          </div>
          <div>
            <div class="font-bold text-lg text-white tracking-tight flex items-center gap-1.5">
              {t.common.brandName}
              <span class="text-[10px] px-1.5 py-0.5 rounded bg-blue-500/10 text-blue-400 border border-blue-500/20 font-mono font-semibold">{t.common.brandTag}</span>
            </div>
            <div class="hidden sm:block text-[11px] text-slate-400 tracking-wider uppercase font-medium">{t.common.brandRole}</div>
          </div>
        </a>

        <!-- Desktop Navigation -->
        <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-slate-300">
          <a href={lp(locale, '/')} class="hover:text-blue-400 transition-colors">{t.common.nav.home}</a>
          <a href={lp(locale, '/products')} class="hover:text-blue-400 transition-colors">{t.common.nav.caseStudies}</a>
          <a href={lp(locale, '/services')} class="hover:text-blue-400 transition-colors">{t.common.nav.services}</a>
          <a href={lp(locale, '/tools')} class="hover:text-blue-400 transition-colors flex items-center gap-1">
            <span>{t.common.nav.tools}</span>
            <span class="text-[9px] px-1 py-0.2 rounded bg-rose-500/10 text-rose-400 font-mono font-semibold border border-rose-500/20">{t.common.nav.toolsNew}</span>
          </a>
          <a href={lp(locale, '/resources')} class="hover:text-blue-400 transition-colors">{t.common.nav.resources}</a>
          <a href={lp(locale, '/about')} class="hover:text-blue-400 transition-colors">{t.common.nav.about}</a>

          <!-- Language Switcher (no-JS dropdown) -->
          <LanguageSwitcher locale={locale} basePath={basePath} variant="desktop" />
        </nav>

        <!-- CTA Action Button & Mobile Menu Toggle -->
        <div class="flex items-center gap-3 shrink-0">
          <a
            href={lp(locale, '/contact#rfq')}
            class="hidden sm:inline-flex items-center justify-center px-4 py-2 rounded-lg text-sm font-semibold text-white bg-blue-600 hover:bg-blue-500 shadow-md shadow-blue-600/30 transition-all hover:-translate-y-0.5"
          >
            {t.common.nav.startProject}
          </a>

          <!-- Mobile Quick Nav Buttons -->
          <div class="flex md:hidden items-center gap-2 text-xs">
            <a href={lp(locale, '/tools')} class="px-2.5 py-1.5 rounded-lg bg-slate-900 border border-slate-800 text-blue-400 font-medium">{t.common.nav.tools}</a>
            <a href={lp(locale, '/resources')} class="px-2.5 py-1.5 rounded-lg bg-slate-900 border border-slate-800 text-slate-300 font-medium">{t.common.nav.mobileHub}</a>
            <a href={lp(locale, '/about')} class="hidden sm:inline-flex px-2.5 py-1.5 rounded-lg bg-slate-900 border border-slate-800 text-slate-300 font-medium">{t.common.nav.about}</a>
            <!-- Language Switcher (mobile) -->
            <LanguageSwitcher locale={locale} basePath={basePath} variant="mobile" />
          </div>
        </div>
      </div>
    </header>

    <!-- Main Page Content -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Global Footer -->
    <footer class="bg-slate-900 border-t border-slate-800 text-slate-400 text-sm">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-10">
          <!-- Col 1: Bio -->
          <div class="space-y-4">
            <div class="flex items-center gap-2">
              <div class="w-8 h-8 rounded bg-blue-600 flex items-center justify-center text-white font-bold text-base">N</div>
              <span class="font-bold text-white text-base tracking-tight">{t.common.brandName} // {t.common.brandTag}</span>
            </div>
            <p class="text-xs text-slate-400 leading-relaxed">
              {t.common.footer.tagline}
            </p>
            <div class="flex items-center gap-2 text-xs text-slate-500 font-mono">
              <span>Shopify</span> • <span>Liquid</span> • <span>Klaviyo</span> • <span>Meta Ads</span> • <span>Astro Edge</span>
            </div>
          </div>

          <!-- Col 2: Projects & Systems -->
          <div>
            <h4 class="text-xs font-semibold uppercase tracking-wider text-slate-200 mb-3">{t.common.footer.systemsHeading}</h4>
            <ul class="space-y-2 text-xs">
              <li><a href={lp(locale, '/products')} class="hover:text-blue-400 transition-colors">{t.common.footer.allCaseStudies}</a></li>
              <li><a href={lp(locale, '/products/sub-second-jamstack-edge-commerce-platform')} class="hover:text-blue-400 transition-colors">{t.common.footer.jewelryCase}</a></li>
              <li><a href={lp(locale, '/products/event-driven-serverless-dispatch-gateway')} class="hover:text-blue-400 transition-colors">{t.common.footer.clickLossCase}</a></li>
              <li><a href={lp(locale, '/products/zero-overhead-web-telemetry-engine')} class="hover:text-blue-400 transition-colors">{t.common.footer.retentionCase}</a></li>
            </ul>
          </div>

          <!-- Col 3: Navigation & Tools -->
          <div>
            <h4 class="text-xs font-semibold uppercase tracking-wider text-slate-200 mb-3">{t.common.footer.navHeading}</h4>
            <ul class="space-y-2 text-xs">
              <li><a href={lp(locale, '/services')} class="hover:text-blue-400 transition-colors">{t.common.footer.servicesLink}</a></li>
              <li><a href={lp(locale, '/about')} class="hover:text-blue-400 transition-colors">{t.common.footer.aboutLink}</a></li>
              <li><a href={lp(locale, '/tools')} class="hover:text-blue-400 transition-colors">{t.common.footer.roiTool}</a></li>
              <li><a href={lp(locale, '/tools/click-loss-auditor')} class="hover:text-blue-400 transition-colors">{t.common.footer.clickLossTool}</a></li>
              <li><a href={lp(locale, '/tools/chargeback-scorecard')} class="hover:text-blue-400 transition-colors">{t.common.footer.scorecardTool}</a></li>
              <li><a href={lp(locale, '/resources')} class="hover:text-blue-400 transition-colors">{t.common.footer.resourcesLink}</a></li>
              <li><a href={lp(locale, '/#articles')} class="hover:text-blue-400 transition-colors">{t.common.footer.whitepapers}</a></li>
              <li><a href={lp(locale, '/faq')} class="hover:text-blue-400 transition-colors">{t.common.footer.faqLink}</a></li>
              <li><a href={lp(locale, '/contact')} class="hover:text-blue-400 transition-colors">{t.common.footer.rfqLink}</a></li>
            </ul>
          </div>

          <!-- Col 4: Contact -->
          <div class="space-y-3">
            <h4 class="text-xs font-semibold uppercase tracking-wider text-slate-200 mb-2">{t.common.footer.advisoryHeading}</h4>
            <div class="text-xs space-y-1.5 text-slate-300">
              <p class="flex items-center gap-2">
                <span class="text-slate-500">{t.common.footer.emailLabel}</span>
                <a href="mailto:dewellsmell@gmail.com" class="text-blue-400 hover:underline">dewellsmell@gmail.com</a>
              </p>
              <p class="flex items-center gap-2">
                <span class="text-slate-500">{t.common.footer.githubLabel}</span>
                <a href="https://github.com/tugg86722-create" target="_blank" rel="noreferrer" class="text-blue-400 hover:underline">tugg86722-create</a>
              </p>
              <p class="text-slate-400 text-[11px] pt-1">
                {t.common.footer.openFor}
              </p>
            </div>
          </div>
        </div>

        <div class="mt-12 pt-6 border-t border-slate-800 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 gap-4">
          <p>© {new Date().getFullYear()} Naif. {t.common.footer.copyright}</p>
          <div class="flex items-center gap-4">
            <span class="text-slate-500">{t.common.footer.domainLabel} <strong class="text-blue-400">{t.common.domain}</strong></span>
          </div>
        </div>
      </div>
    </footer>
    <Analytics />
  </body>
</html>
