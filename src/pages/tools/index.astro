---
import Layout from '../../layouts/Layout.astro';

const defaultSpend = 10000;
const defaultCpc = 2.5;
const defaultLoadTime = 4.2;
const defaultCvr = 1.8;
---

<Layout
  title="Web Performance & Ad ROI Waste Calculator | Naif | Edge Architect"
  description="Calculate how much of your monthly ad spend is lost to mobile loading latency. Interactive ROI leakage calculator based on Google & Cloudflare Core Web Vitals research."
>
  <!-- Breadcrumb -->
  <div class="border-b border-slate-800 bg-slate-900/60 py-3">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-xs text-slate-400">
        <a href="/" class="hover:text-blue-400 transition-colors">Home</a>
        <span>/</span>
        <span class="text-blue-400">Interactive Tools</span>
        <span>/</span>
        <span class="text-slate-200">Ad ROI & Latency Waste Calculator</span>
      </nav>
    </div>
  </div>

  <section class="py-12 sm:py-16 lg:py-20 bg-slate-950 relative overflow-hidden">
    <!-- Background Accents -->
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#1e293b0a_1px,transparent_1px),linear-gradient(to_bottom,#1e293b0a_1px,transparent_1px)] bg-[size:32px_32px]"></div>
    <div class="absolute top-12 left-1/2 -translate-x-1/2 w-[700px] h-[300px] bg-blue-600/10 rounded-full blur-[140px] pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <!-- Section Header -->
      <div class="max-w-3xl mb-12">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/20 text-xs font-semibold text-blue-400 mb-4">
          <span class="w-2 h-2 rounded-full bg-blue-400 animate-pulse"></span>
          <span>Google & Cloudflare Latency Impact Correlation Engine</span>
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight leading-tight mb-4">
          Web Performance & <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-indigo-300 to-rose-400">Ad ROI Waste</span> Calculator
        </h1>
        <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
          Slow mobile loading times do not just frustrate visitors—they burn paid marketing capital. Measure how latency inflates bounce rates, discards paid clicks before first paint, and calculate the exact financial upside of upgrading to a sub-1.0s Jamstack architecture.
        </p>
      </div>

      <!-- Main Calculator Stage -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <!-- Left: Input Controls Panel (5 cols) -->
        <div class="lg:col-span-5 bg-slate-900 border border-slate-800 rounded-2xl p-6 sm:p-8 shadow-2xl space-y-6">
          <div class="flex items-center justify-between pb-4 border-b border-slate-800">
            <h2 class="text-base font-bold text-white flex items-center gap-2">
              <svg class="w-5 h-5 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
              </svg>
              <span>Campaign & Latency Inputs</span>
            </h2>
            <button
              id="reset-btn"
              type="button"
              class="text-xs text-slate-400 hover:text-blue-400 transition-colors underline underline-offset-2"
            >
              Reset Defaults
            </button>
          </div>

          <!-- Input 1: Monthly Ad Spend -->
          <div class="space-y-2">
            <div class="flex justify-between items-center text-xs">
              <label for="spend-input" class="font-semibold text-slate-300">Monthly Paid Ad Spend ($)</label>
              <div class="flex items-center bg-slate-950 border border-slate-700 rounded-lg px-2.5 py-1">
                <span class="text-slate-500 mr-1">$</span>
                <input
                  id="spend-input"
                  type="number"
                  min="500"
                  max="200000"
                  step="250"
                  value={defaultSpend}
                  class="w-20 bg-transparent text-right font-mono font-bold text-white focus:outline-none"
                />
              </div>
            </div>
            <input
              id="spend-range"
              type="range"
              min="500"
              max="100000"
              step="500"
              value={defaultSpend}
              class="w-full accent-blue-500 cursor-pointer bg-slate-800 h-2 rounded-lg"
            />
            <div class="flex justify-between text-[11px] text-slate-500 font-mono">
              <span>$500</span>
              <span>$50,000</span>
              <span>$100,000+</span>
            </div>
          </div>

          <!-- Input 2: Average Cost Per Click (CPC) -->
          <div class="space-y-2">
            <div class="flex justify-between items-center text-xs">
              <label for="cpc-input" class="font-semibold text-slate-300">Average CPC ($ USD)</label>
              <div class="flex items-center bg-slate-950 border border-slate-700 rounded-lg px-2.5 py-1">
                <span class="text-slate-500 mr-1">$</span>
                <input
                  id="cpc-input"
                  type="number"
                  min="0.20"
                  max="25.00"
                  step="0.10"
                  value={defaultCpc}
                  class="w-16 bg-transparent text-right font-mono font-bold text-white focus:outline-none"
                />
              </div>
            </div>
            <input
              id="cpc-range"
              type="range"
              min="0.20"
              max="15.00"
              step="0.10"
              value={defaultCpc}
              class="w-full accent-blue-500 cursor-pointer bg-slate-800 h-2 rounded-lg"
            />
            <div class="flex justify-between text-[11px] text-slate-500 font-mono">
              <span>$0.20</span>
              <span>$5.00</span>
              <span>$15.00</span>
            </div>
          </div>

          <!-- Input 3: Mobile Page Load Time (Seconds) -->
          <div class="space-y-2">
            <div class="flex justify-between items-center text-xs">
              <label for="loadtime-input" class="font-semibold text-slate-300">Current Mobile Load Time (Seconds)</label>
              <div class="flex items-center bg-slate-950 border border-slate-700 rounded-lg px-2.5 py-1">
                <input
                  id="loadtime-input"
                  type="number"
                  min="0.8"
                  max="7.0"
                  step="0.1"
                  value={defaultLoadTime}
                  class="w-14 bg-transparent text-right font-mono font-bold text-white focus:outline-none"
                />
                <span class="text-slate-500 ml-1">s</span>
              </div>
            </div>
            <input
              id="loadtime-range"
              type="range"
              min="0.8"
              max="7.0"
              step="0.1"
              value={defaultLoadTime}
              class="w-full accent-indigo-500 cursor-pointer bg-slate-800 h-2 rounded-lg"
            />
            <div class="flex justify-between text-[11px] text-slate-500 font-mono">
              <span class="text-emerald-400 font-semibold">0.8s (Jamstack)</span>
              <span class="text-amber-400">3.0s</span>
              <span class="text-rose-400">7.0s (Severe)</span>
            </div>
          </div>

          <!-- Input 4: Current Conversion Rate (%) -->
          <div class="space-y-2">
            <div class="flex justify-between items-center text-xs">
              <label for="cvr-input" class="font-semibold text-slate-300">Current Mobile Conversion Rate (%)</label>
              <div class="flex items-center bg-slate-950 border border-slate-700 rounded-lg px-2.5 py-1">
                <input
                  id="cvr-input"
                  type="number"
                  min="0.1"
                  max="10.0"
                  step="0.1"
                  value={defaultCvr}
                  class="w-14 bg-transparent text-right font-mono font-bold text-white focus:outline-none"
                />
                <span class="text-slate-500 ml-1">%</span>
              </div>
            </div>
            <input
              id="cvr-range"
              type="range"
              min="0.2"
              max="6.0"
              step="0.1"
              value={defaultCvr}
              class="w-full accent-blue-500 cursor-pointer bg-slate-800 h-2 rounded-lg"
            />
            <div class="flex justify-between text-[11px] text-slate-500 font-mono">
              <span>0.2%</span>
              <span>2.5%</span>
              <span>6.0%</span>
            </div>
          </div>

          <!-- Industry Benchmark Citation Notice -->
          <div class="p-3.5 rounded-xl bg-slate-950/70 border border-slate-800 text-[11px] text-slate-400 leading-relaxed">
            <div class="font-semibold text-slate-300 mb-1 flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-blue-400" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
              </svg>
              <span>Ground Truth Data Model</span>
            </div>
            Grounded on Google Research & SOASTA mobile telemetry: 53% of mobile visits are abandoned if pages take over 3 seconds to load; conversion rate drops by up to 4.42% with each additional second of delay.
          </div>
        </div>

        <!-- Right: Results & Financial Impact Dashboard (7 cols) -->
        <div class="lg:col-span-7 space-y-6">
          <!-- Primary Metric Summary Cards -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <!-- Card 1: Wasted Monthly Spend -->
            <div class="bg-slate-900 border border-rose-500/30 rounded-2xl p-6 relative overflow-hidden group">
              <div class="absolute top-0 right-0 w-32 h-32 bg-rose-500/10 rounded-full blur-2xl pointer-events-none"></div>
              <div class="text-[11px] uppercase tracking-wider font-semibold text-rose-400 mb-1 flex items-center justify-between">
                <span>Monthly Ad Budget Wasted</span>
                <span id="health-pill" class="text-[10px] px-2 py-0.5 rounded-full font-mono bg-rose-500/10 text-rose-400 border border-rose-500/30">
                  Critical Leakage
                </span>
              </div>
              <div class="text-3xl sm:text-4xl font-black text-white font-mono tracking-tight" id="metric-wasted-spend">
                $3,240
              </div>
              <p class="text-xs text-slate-400 mt-2">
                Estimated capital lost to bounces before the page renders on 4G mobile devices.
              </p>
              <div class="mt-4 pt-3 border-t border-slate-800 flex justify-between text-xs text-slate-400">
                <span>Annualized Loss:</span>
                <strong class="text-rose-400 font-mono" id="metric-wasted-annual">$38,880 / yr</strong>
              </div>
            </div>

            <!-- Card 2: Abandoned Paid Clicks -->
            <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 relative overflow-hidden">
              <div class="text-[11px] uppercase tracking-wider font-semibold text-amber-400 mb-1">
                Abandoned Clicks / Month
              </div>
              <div class="text-3xl sm:text-4xl font-black text-white font-mono tracking-tight" id="metric-bounced-clicks">
                1,296
              </div>
              <p class="text-xs text-slate-400 mt-2">
                Out of <span id="metric-total-clicks" class="text-slate-200 font-semibold font-mono">4,000</span> paid visits, bounced due to mobile rendering stalls.
              </p>
              <div class="mt-4 pt-3 border-t border-slate-800 flex justify-between text-xs text-slate-400">
                <span>Mobile Bounce Penalty:</span>
                <strong class="text-amber-400 font-mono" id="metric-bounce-penalty">+68.4%</strong>
              </div>
            </div>

            <!-- Card 3: Recoverable Monthly Conversions -->
            <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 relative overflow-hidden">
              <div class="text-[11px] uppercase tracking-wider font-semibold text-blue-400 mb-1">
                Recoverable Conversions
              </div>
              <div class="text-3xl sm:text-4xl font-black text-white font-mono tracking-tight text-emerald-400" id="metric-recovered-cvr">
                +29 orders/mo
              </div>
              <p class="text-xs text-slate-400 mt-2">
                Projected incremental customers captured with sub-1.0s Jamstack edge delivery.
              </p>
              <div class="mt-4 pt-3 border-t border-slate-800 flex justify-between text-xs text-slate-400">
                <span>Estimated Annual Orders:</span>
                <strong class="text-emerald-400 font-mono" id="metric-recovered-annual">+348 orders</strong>
              </div>
            </div>

            <!-- Card 4: Potential Recovered Annual Revenue -->
            <div class="bg-slate-900 border border-blue-500/30 rounded-2xl p-6 relative overflow-hidden">
              <div class="absolute top-0 right-0 w-32 h-32 bg-blue-500/10 rounded-full blur-2xl pointer-events-none"></div>
              <div class="text-[11px] uppercase tracking-wider font-semibold text-blue-400 mb-1">
                Projected Annual ROI Upside
              </div>
              <div class="text-3xl sm:text-4xl font-black text-white font-mono tracking-tight" id="metric-recovered-value">
                +$48,720
              </div>
              <p class="text-xs text-slate-400 mt-2">
                Calculated value of retained traffic + sub-second conversion rate multiplier.
              </p>
              <div class="mt-4 pt-3 border-t border-slate-800 flex justify-between text-xs text-slate-400">
                <span>Architecture Payback Period:</span>
                <strong class="text-blue-400 font-mono">&lt; 30 Days</strong>
              </div>
            </div>
          </div>

          <!-- Visual Speed Differential Comparison -->
          <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6">
            <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-300 mb-4 flex items-center justify-between">
              <span>Latency vs Conversion Differential</span>
              <span class="text-slate-500 font-mono font-normal">Google SOASTA Index</span>
            </h3>

            <!-- Bar 1: Current State -->
            <div class="space-y-1.5 mb-4">
              <div class="flex justify-between text-xs">
                <span class="text-slate-400">Current Infrastructure Latency:</span>
                <span class="font-mono font-bold text-rose-400" id="label-current-latency">4.2s (Monolithic CMS / Plugin Overhead)</span>
              </div>
              <div class="w-full bg-slate-950 h-3 rounded-full overflow-hidden border border-slate-800">
                <div id="bar-current" class="h-full bg-gradient-to-r from-amber-500 to-rose-500 rounded-full transition-all duration-300" style="width: 65%;"></div>
              </div>
              <div class="text-[11px] text-slate-500">High hydration overhead, blocking JS bundles, database roundtrips.</div>
            </div>

            <!-- Bar 2: Edge Jamstack Architecture -->
            <div class="space-y-1.5">
              <div class="flex justify-between text-xs">
                <span class="text-slate-400">Naif's Jamstack Edge Architecture:</span>
                <span class="font-mono font-bold text-emerald-400">0.8s (Anycast Edge + Zero-JS Islands)</span>
              </div>
              <div class="w-full bg-slate-950 h-3 rounded-full overflow-hidden border border-slate-800">
                <div class="h-full bg-gradient-to-r from-blue-500 to-emerald-400 rounded-full" style="width: 14%;"></div>
              </div>
              <div class="text-[11px] text-emerald-400/80">Pre-rendered HTML at 300+ edge nodes, instant First Contentful Paint, 0ms cold starts.</div>
            </div>
          </div>

          <!-- Engineering Recommendations & Action Plan -->
          <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-6 sm:p-7 space-y-4">
            <h3 class="text-sm font-bold text-white flex items-center gap-2">
              <svg class="w-4 h-4 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
              <span>Architectural Remediation Roadmap</span>
            </h3>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs text-slate-300">
              <div class="p-3 rounded-xl bg-slate-950 border border-slate-800/80">
                <strong class="text-white block mb-1">1. Edge TTFB Elimination</strong>
                Replace origin server database parsing with Cloudflare Workers pre-rendered edge HTML, bringing TTFB under 60ms globally.
              </div>
              <div class="p-3 rounded-xl bg-slate-950 border border-slate-800/80">
                <strong class="text-white block mb-1">2. Zero-JS Hydration Stripping</strong>
                Migrate heavy SPA or WooCommerce/Shopify theme scripts to Astro Islands, eliminating 90%+ of client-side main-thread freezing.
              </div>
              <div class="p-3 rounded-xl bg-slate-950 border border-slate-800/80">
                <strong class="text-white block mb-1">3. Automated Image Transcoding</strong>
                Serve responsive AVIF/WebP assets via Cloudflare Images directly matching physical screen DPR with zero layout shift (CLS = 0).
              </div>
              <div class="p-3 rounded-xl bg-slate-950 border border-slate-800/80">
                <strong class="text-white block mb-1">4. Serverless RFQ & Checkout</strong>
                Route form leads and order requests asynchronously via cloud queues (Cloudflare Queues/KV) with sub-100ms response guarantees.
              </div>
            </div>

            <!-- Call to Action Banner -->
            <div class="mt-6 pt-6 border-t border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-4">
              <div>
                <div class="text-sm font-bold text-white">Stop Burning Paid Ad Spend</div>
                <div class="text-xs text-slate-400">Request a comprehensive latency breakdown and migration proposal for your store or app.</div>
              </div>
              <a
                href="/contact#rfq"
                class="px-5 py-2.5 rounded-xl text-xs font-semibold text-white bg-blue-600 hover:bg-blue-500 shadow-md shadow-blue-600/30 transition-all hover:-translate-y-0.5 whitespace-nowrap"
              >
                Request Architecture Audit →
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script is:inline>
  function initCalculator() {
    const spendInput = document.getElementById('spend-input');
    const spendRange = document.getElementById('spend-range');
    const cpcInput = document.getElementById('cpc-input');
    const cpcRange = document.getElementById('cpc-range');
    const loadtimeInput = document.getElementById('loadtime-input');
    const loadtimeRange = document.getElementById('loadtime-range');
    const cvrInput = document.getElementById('cvr-input');
    const cvrRange = document.getElementById('cvr-range');
    const resetBtn = document.getElementById('reset-btn');

    const metricWastedSpend = document.getElementById('metric-wasted-spend');
    const metricWastedAnnual = document.getElementById('metric-wasted-annual');
    const metricBouncedClicks = document.getElementById('metric-bounced-clicks');
    const metricTotalClicks = document.getElementById('metric-total-clicks');
    const metricBouncePenalty = document.getElementById('metric-bounce-penalty');
    const metricRecoveredCvr = document.getElementById('metric-recovered-cvr');
    const metricRecoveredAnnual = document.getElementById('metric-recovered-annual');
    const metricRecoveredValue = document.getElementById('metric-recovered-value');
    const healthPill = document.getElementById('health-pill');
    const labelCurrentLatency = document.getElementById('label-current-latency');
    const barCurrent = document.getElementById('bar-current');

    function syncInputs(source, target) {
      target.value = source.value;
      recalculate();
    }

    function formatCurrency(val) {
      return '$' + Math.round(val).toLocaleString('en-US');
    }

    function recalculate() {
      const spend = parseFloat(spendInput.value) || 0;
      const cpc = parseFloat(cpcInput.value) || 1;
      const loadTime = parseFloat(loadtimeInput.value) || 1;
      const cvr = parseFloat(cvrInput.value) || 1;

      // 1. Total paid clicks bought
      const totalClicks = cpc > 0 ? spend / cpc : 0;

      // 2. Latency Bounce Penalty Model (Google / SOASTA / Cloudflare empirical data)
      // Baseline: <= 1.0s is optimal Jamstack edge
      let bouncePenaltyPercent = 0;
      if (loadTime > 1.0) {
        if (loadTime <= 2.5) {
          bouncePenaltyPercent = (loadTime - 1.0) * 18; // up to 27%
        } else if (loadTime <= 4.5) {
          bouncePenaltyPercent = 27 + (loadTime - 2.5) * 22; // up to 71%
        } else {
          bouncePenaltyPercent = 71 + (loadTime - 4.5) * 12; // up to 101%
        }
      }

      // Latency bounce loss coefficient (fraction of clicks that abandon before FCP / interactive)
      // At 1.0s, loss is negligible. At 4.2s, approx 32% of traffic bounces before paint.
      const abandonRatio = loadTime <= 1.0 ? 0 : Math.min(0.75, (bouncePenaltyPercent / 100) * 0.46);

      const bouncedClicks = Math.round(totalClicks * abandonRatio);
      const wastedMonthlySpend = bouncedClicks * cpc;
      const wastedAnnualSpend = wastedMonthlySpend * 12;

      // 3. Conversion Recovery Upside
      // Sub-second sites convert at approx 1.35x - 1.8x due to frictionless user journey
      const baselineSubSecondCvr = cvr * (1 + Math.max(0, (loadTime - 1.0) * 0.12));
      const recoveredMonthlyConversions = Math.round(bouncedClicks * (baselineSubSecondCvr / 100));
      const recoveredAnnualConversions = recoveredMonthlyConversions * 12;

      // Estimated Average Order Value or Value Per Conversion derived from spend / conversions
      const avgOrderValue = Math.max(45, (cpc / (cvr / 100)) * 1.5);
      const recoveredAnnualValue = Math.round(recoveredAnnualConversions * avgOrderValue);

      // Update DOM
      metricWastedSpend.textContent = formatCurrency(wastedMonthlySpend);
      metricWastedAnnual.textContent = formatCurrency(wastedAnnualSpend) + ' / yr';
      metricBouncedClicks.textContent = bouncedClicks.toLocaleString('en-US');
      metricTotalClicks.textContent = Math.round(totalClicks).toLocaleString('en-US');
      metricBouncePenalty.textContent = '+' + bouncePenaltyPercent.toFixed(1) + '%';
      metricRecoveredCvr.textContent = '+' + recoveredMonthlyConversions + ' orders/mo';
      metricRecoveredAnnual.textContent = '+' + recoveredAnnualConversions.toLocaleString('en-US') + ' orders';
      metricRecoveredValue.textContent = '+' + formatCurrency(recoveredAnnualValue);

      labelCurrentLatency.textContent = loadTime.toFixed(1) + 's (' + (loadTime > 3.0 ? 'High Latency / Bottleneck' : 'Moderate Speed') + ')';
      
      const barWidth = Math.min(100, Math.max(15, (loadTime / 7.0) * 100));
      barCurrent.style.width = barWidth + '%';

      // Update Health Pill
      if (loadTime <= 1.2) {
        healthPill.className = 'text-[10px] px-2 py-0.5 rounded-full font-mono bg-emerald-500/10 text-emerald-400 border border-emerald-500/30';
        healthPill.textContent = 'Optimal Edge Speed';
      } else if (loadTime <= 2.5) {
        healthPill.className = 'text-[10px] px-2 py-0.5 rounded-full font-mono bg-amber-500/10 text-amber-400 border border-amber-500/30';
        healthPill.textContent = 'Moderate Friction';
      } else if (loadTime <= 4.0) {
        healthPill.className = 'text-[10px] px-2 py-0.5 rounded-full font-mono bg-orange-500/10 text-orange-400 border border-orange-500/30';
        healthPill.textContent = 'Severe Drop-Off';
      } else {
        healthPill.className = 'text-[10px] px-2 py-0.5 rounded-full font-mono bg-rose-500/10 text-rose-400 border border-rose-500/30';
        healthPill.textContent = 'Critical Budget Waste';
      }
    }

    spendInput.addEventListener('input', () => syncInputs(spendInput, spendRange));
    spendRange.addEventListener('input', () => syncInputs(spendRange, spendInput));

    cpcInput.addEventListener('input', () => syncInputs(cpcInput, cpcRange));
    cpcRange.addEventListener('input', () => syncInputs(cpcRange, cpcInput));

    loadtimeInput.addEventListener('input', () => syncInputs(loadtimeInput, loadtimeRange));
    loadtimeRange.addEventListener('input', () => syncInputs(loadtimeRange, loadtimeInput));

    cvrInput.addEventListener('input', () => syncInputs(cvrInput, cvrRange));
    cvrRange.addEventListener('input', () => syncInputs(cvrRange, cvrInput));

    resetBtn.addEventListener('click', () => {
      spendInput.value = 10000;
      spendRange.value = 10000;
      cpcInput.value = 2.5;
      cpcRange.value = 2.5;
      loadtimeInput.value = 4.2;
      loadtimeRange.value = 4.2;
      cvrInput.value = 1.8;
      cvrRange.value = 1.8;
      recalculate();
    });

    recalculate();
  }

  // Support direct page load and Astro view transitions if enabled
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCalculator);
  } else {
    initCalculator();
  }
</script>
