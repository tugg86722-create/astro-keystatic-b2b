---
import Layout from '../../layouts/Layout.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';

interface Question {
  id: string;
  q: string;
  why: string;
  options: { label: string; score: number; fix: string }[];
}

const questions: Question[] = [
  {
    id: 'fulfillment-truth',
    q: 'Does what arrives in the parcel match what the product page promised — material, weight, quantity, finish?',
    why: 'Mismatched fulfilment is the single fastest-growing dispute reason. It is also the hardest to defend, because the merchant’s own listing is the evidence.',
    options: [
      { label: 'Yes — we audit shipments against listing claims', score: 0, fix: 'Hold this line. Document the audit so you can defend it.' },
      { label: 'Partly — some lines are checked, others are not', score: 12, fix: 'Pick your top 5 SKUs by revenue and audit those first. Cover the top 80% of revenue with the same discipline you apply to the rest.' },
      { label: 'No — listings are written for conversion, not for accuracy', score: 20, fix: 'Highest-leverage fix on this list. Rewrite the 10 highest-traffic product pages so every claim in the copy is one the parcel can substantiate.' },
    ],
  },
  {
    id: 'delivery-promise',
    q: 'Does the delivery date shown at checkout match what the carrier actually delivers?',
    why: 'Late delivery is the leading cause of chargebacks in apparel and home goods. Buyers dispute on the promise, not the parcel.',
    options: [
      { label: 'Yes — the date at checkout is carrier-verified', score: 0, fix: 'Keep the delivery estimate tied to live carrier data, not a static buffer.' },
      { label: 'We pad the estimate with a buffer, but do not track actuals', score: 10, fix: 'Start tracking promised vs actual delivery. A 3–5 day buffer priced against your actual late rate is cheaper than disputes.' },
      { label: 'No — the estimate is optimistic and delivery is routinely late', score: 20, fix: 'Show the accurate window, even if it costs you a few clicks. A 9–12 day honest estimate beats a 5-day broken promise.' },
    ],
  },
  {
    id: 'refund-speed',
    q: 'When a customer asks for a refund, how fast do they get it?',
    why: 'A slow refund converts a service complaint into a chargeback. The buyer’s alternative is to let the deadline pass and let the issuer decide.',
    options: [
      { label: 'Same day, automatically', score: 0, fix: 'Nothing to fix — this directly suppresses dispute volume.' },
      { label: 'Within 3–5 business days', score: 10, fix: 'Automate instant refunds for the first 30 days post-delivery, then hand off to your team.' },
      { label: 'It depends — often more than 10 days', score: 20, fix: 'Set a hard 24–48 hour SLA with automated approval on clear cases. This alone typically cuts disputes by a third.' },
    ],
  },
  {
    id: 'order-comms',
    q: 'Do customers get order confirmation, dispatch notice and a working tracking link — automatically?',
    why: 'Silence after checkout is what turns a neutral buyer into a disputing one. The buyer assumes the worst when they hear nothing.',
    options: [
      { label: 'Yes — all three, triggered by real events', score: 0, fix: 'Keep the flow event-driven, not on a fixed schedule.' },
      { label: 'Partly — confirmation and dispatch yes, tracking often missing', score: 8, fix: 'Add a tracking-number email that fires on label creation, not on manual entry.' },
      { label: 'No — customers have to chase us', score: 16, fix: 'Wire Klaviyo transactional flows to your fulfilment events. This is a two-day build and it is the fastest dispute reduction available.' },
    ],
  },
  {
    id: 'expectation-setting',
    q: 'For your higher-ticket items, is there visual and material evidence of what the buyer will receive?',
    why: 'Above roughly $100, buyers buy from images. If the images are stylised and the parcel is plain, the refund request comes first and the dispute comes second.',
    options: [
      { label: 'Yes — real product photos, detail shots, scale reference', score: 0, fix: 'Protect this. Real photos are also the strongest CRO asset you own.' },
      { label: 'Lifestyle shots only, no scale or detail reference', score: 10, fix: 'Add a scale reference and two macro detail shots per hero SKU. Cheaper than any discount you will have to give.' },
      { label: 'Stylised or heavily edited imagery', score: 18, fix: 'This is a direct dispute generator at ticket. Replace edited imagery with unretouched, scale-accurate photography.' },
    ],
  },
  {
    id: 'review-integrity',
    q: 'Are your reviews, ratings and testimonials real and verifiable?',
    why: 'Fabricated or incentivised reviews are a card-brand and platform violation. The penalty is not just a fine — it is the ability to settle disputes in your favour.',
    options: [
      { label: 'Yes — verified-buyer reviews only, no incentivised posts', score: 0, fix: 'Keep the verification trail documented.' },
      { label: 'Mostly real, but we do run an incentive programme', score: 14, fix: 'Move the incentive to a post-purchase survey that is not conditioned on a positive review, and keep the review body unedited.' },
      { label: 'We do not know where our reviews come from', score: 20, fix: 'Audit the review app, the app blocks and any historic incentivised campaign. Remove anything that cannot be traced to a real order.' },
    ],
  },
  {
    id: 'dispute-defence',
    q: 'Do you monitor disputes in real time and submit evidence before the deadline?',
    why: 'The representment window is short and most merchants miss it by default. Evidence submitted inside the window wins; evidence submitted late does not.',
    options: [
      { label: 'Yes — we submit evidence for every dispute', score: 0, fix: 'Keep the evidence template library documented per category.' },
      { label: 'We react when the email arrives, often late', score: 12, fix: 'Build a standing evidence pack per SKU category: order, tracking, delivery photo, listing snapshot. Automate the deadline calendar.' },
      { label: 'We rarely win these', score: 20, fix: 'This is the highest-return item on the list. A standing evidence pack is usually the difference between winning and losing a dispute.' },
    ],
  },
  {
    id: 'unboxing-parcel',
    q: 'Does the parcel arrive in a condition that matches the brand promise?',
    why: 'Damage, crushed corners and missing inserts are read as a low-value product. The buyer disputes the order and the shipment simultaneously.',
    options: [
      { label: 'Yes — packaging is tested and protected', score: 0, fix: 'Hold this. Include an unboxing photo in your dispute evidence pack.' },
      { label: 'Generally fine, but fragile or heavy items are the weak spot', score: 10, fix: 'Add corner protection and a tested drop spec for the fragile SKUs only. You do not need to repackage everything.' },
      { label: 'Not really — we ship in the minimum box', score: 16, fix: 'For premium and fragile lines, the packaging is part of the product. A mailer and a moulded insert is cheaper than one chargeback.' },
    ],
  },
];

const totalPoints = questions.reduce((sum, q) => sum + Math.max(...q.options.map((o) => o.score)), 0);
---

<Layout
  title="Chargeback Risk Scorecard — Free DTC Seller Health Diagnostic | Naif"
  description="Free 8-question diagnostic that scores your chargeback exposure, prices the risk, and gives you the specific fix for every red flag. Built on fulfilment-truth, delivery promise and dispute defence."
>
  <!-- Breadcrumb -->
  <div class="border-b border-slate-800 bg-slate-900/60 py-3">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-xs text-slate-400">
        <a href="/" class="hover:text-blue-400 transition-colors">Home</a>
        <span>/</span>
        <a href="/tools" class="hover:text-blue-400 transition-colors">Interactive Tools</a>
        <span>/</span>
        <span class="text-slate-200">Chargeback Risk Scorecard</span>
      </nav>
    </div>
  </div>

  <section class="py-12 sm:py-16 bg-slate-950 relative overflow-hidden">
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#1e293b0a_1px,transparent_1px),linear-gradient(to_bottom,#1e293b0a_1px,transparent_1px)] bg-[size:32px_32px]"></div>
    <div class="absolute top-12 left-1/2 -translate-x-1/2 w-[700px] h-[300px] bg-blue-600/10 rounded-full blur-[140px] pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <!-- Header -->
      <div class="max-w-3xl mb-10">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/20 text-xs font-semibold text-blue-400 mb-4">
          <span class="w-2 h-2 rounded-full bg-blue-400 animate-pulse"></span>
          <span>Seller Health Diagnostic · 8 Questions</span>
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight leading-tight mb-4">
          Chargeback <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-indigo-300 to-rose-400">Risk Scorecard</span>
        </h1>
        <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
          A chargeback is not a payment problem. It is a fulfilment-truth problem that got escalated — and the merchant usually has the evidence to win it. Eight questions, one risk score, and the specific fix for every red flag you hit. Most brands finish in under three minutes.
        </p>
      </div>

      <!-- Exposure inputs -->
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 sm:p-7 mb-8 grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="space-y-2">
          <div class="flex justify-between items-center text-xs">
            <label for="gmv-input" class="font-semibold text-slate-300">Monthly Revenue ($)</label>
            <div class="flex items-center bg-slate-950 border border-slate-700 rounded-lg px-2.5 py-1">
              <span class="text-slate-500 mr-1">$</span>
              <input id="gmv-input" type="number" min="1000" max="10000000" step="500" value="60000" class="w-20 bg-transparent text-right font-mono font-bold text-white focus:outline-none" />
            </div>
          </div>
          <p class="text-[11px] text-slate-500 leading-relaxed">Used to price the exposure in dollars.</p>
        </div>

        <div class="space-y-2">
          <div class="flex justify-between items-center text-xs">
            <label for="cb-rate-input" class="font-semibold text-slate-300">Current Chargeback Rate (%)</label>
            <div class="flex items-center bg-slate-950 border border-slate-700 rounded-lg px-2.5 py-1">
              <input id="cb-rate-input" type="number" min="0" max="5" step="0.01" value="0.42" class="w-16 bg-transparent text-right font-mono font-bold text-white focus:outline-none" />
              <span class="text-slate-500 ml-1">%</span>
            </div>
          </div>
          <p class="text-[11px] text-slate-500 leading-relaxed">Card networks flag a threshold near 1%. Check your processor dashboard.</p>
        </div>

        <div class="space-y-2">
          <div class="flex justify-between items-center text-xs">
            <label for="aov-input" class="font-semibold text-slate-300">Average Order Value ($)</label>
            <div class="flex items-center bg-slate-950 border border-slate-700 rounded-lg px-2.5 py-1">
              <span class="text-slate-500 mr-1">$</span>
              <input id="aov-input" type="number" min="10" max="2000" step="5" value="120" class="w-16 bg-transparent text-right font-mono font-bold text-white focus:outline-none" />
            </div>
          </div>
          <p class="text-[11px] text-slate-500 leading-relaxed">Disputes scale with ticket size — a $40 order rarely gets disputed, a $200 one does.</p>
        </div>
      </div>

      <!-- Questions -->
      <div id="question-list" class="space-y-4">
        {questions.map((q, qi) => (
          <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 sm:p-7" data-qid={q.id} data-max={Math.max(...q.options.map((o) => o.score))}>
            <div class="flex items-start gap-3.5 mb-4">
              <span class="shrink-0 w-8 h-8 rounded-lg bg-blue-600/10 text-blue-400 border border-blue-500/20 font-mono text-xs font-bold flex items-center justify-center mt-0.5">
                {String(qi + 1).padStart(2, '0')}
              </span>
              <div>
                <h2 class="text-sm sm:text-base font-bold text-white leading-snug">{q.q}</h2>
                <p class="text-xs text-slate-500 leading-relaxed mt-1.5">{q.why}</p>
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
              {q.options.map((o, oi) => (
                <label class="cursor-pointer group">
                  <input type="radio" name={q.id} value={oi} class="peer sr-only" checked={oi === 0} />
                  <span class="flex items-start gap-2.5 h-full p-3.5 rounded-xl bg-slate-950 border border-slate-800 group-hover:border-slate-700 peer-checked:border-blue-500/60 peer-checked:bg-blue-950/40 transition-colors">
                    <span class="shrink-0 w-4 h-4 rounded-full border border-slate-600 group-hover:border-slate-500 peer-checked:border-blue-400 mt-0.5 flex items-center justify-center">
                      <span class="w-2 h-2 rounded-full bg-blue-400 scale-0 peer-checked:scale-100 transition-transform"></span>
                    </span>
                    <span class="text-xs text-slate-300 leading-relaxed peer-checked:text-white">{o.label}</span>
                  </span>
                </label>
              ))}
            </div>
          </div>
        ))}
      </div>

      <!-- Calculate button -->
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-between gap-4 bg-slate-900 border border-slate-800 rounded-2xl p-6">
        <div class="text-xs text-slate-400 leading-relaxed">
          <strong class="text-white block mb-1 text-sm">Ready to score it?</strong>
          Your answers stay in the browser — nothing is sent until you choose to email the report.
        </div>
        <button
          id="score-btn"
          type="button"
          class="px-7 py-3.5 rounded-xl text-sm font-semibold bg-blue-600 hover:bg-blue-500 text-white shadow-lg shadow-blue-600/30 transition-all hover:-translate-y-0.5 cursor-pointer whitespace-nowrap"
        >
          Calculate My Risk Score
        </button>
      </div>

      <!-- Results -->
      <div id="results" class="hidden mt-8 space-y-6">
        <!-- Score card -->
        <div class="bg-gradient-to-br from-slate-900 to-blue-950/30 border border-slate-800 rounded-2xl p-6 sm:p-8">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
            <div class="lg:col-span-4 text-center">
              <div class="text-[11px] uppercase tracking-wider text-slate-400 font-semibold mb-2">Chargeback Risk Score</div>
              <div class="text-6xl font-black font-mono tracking-tight" id="score-value">0</div>
              <div class="text-[11px] text-slate-500 font-mono mb-4">out of {totalPoints}</div>
              <span id="score-tier" class="inline-block px-4 py-1.5 rounded-full text-xs font-bold">—</span>
            </div>

            <div class="lg:col-span-8 space-y-5">
              <p class="text-sm text-slate-300 leading-relaxed" id="score-verdict">—</p>

              <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <div class="bg-slate-950 border border-slate-800 rounded-xl p-4">
                  <div class="text-[11px] uppercase tracking-wider text-rose-400 font-semibold mb-1">Annual Exposure</div>
                  <div class="text-xl font-black text-white font-mono" id="metric-exposure">$0</div>
                  <p class="text-[11px] text-slate-500 mt-1 leading-relaxed">Revenue at risk at your current dispute rate.</p>
                </div>
                <div class="bg-slate-950 border border-slate-800 rounded-xl p-4">
                  <div class="text-[11px] uppercase tracking-wider text-emerald-400 font-semibold mb-1">Recoverable / Year</div>
                  <div class="text-xl font-black text-white font-mono" id="metric-recoverable">$0</div>
                  <p class="text-[11px] text-slate-500 mt-1 leading-relaxed">If you reach a 0.1% dispute rate.</p>
                </div>
                <div class="bg-slate-950 border border-slate-800 rounded-xl p-4">
                  <div class="text-[11px] uppercase tracking-wider text-amber-400 font-semibold mb-1">Disputes / Year</div>
                  <div class="text-xl font-black text-white font-mono" id="metric-disputes">0</div>
                  <p class="text-[11px] text-slate-500 mt-1 leading-relaxed">At your current rate, before fees.</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Flagged items -->
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 sm:p-7">
          <h3 class="text-sm font-bold text-white mb-1">Your Fix Queue, Highest Impact First</h3>
          <p class="text-xs text-slate-500 mb-5">Each red flag carries the specific remediation, not generic advice.</p>
          <div id="fix-list" class="space-y-3"></div>
        </div>

        <!-- Email gate -->
        <div>
          <NewsletterSignup
            source="chargeback-scorecard"
            heading="Get the full seller-health report"
            subheading="Your score, the evidence pack template per SKU category, and a 90-day dispute-reduction sequence for your store."
            ctaLabel="Send Me The Report"
            showNameField={true}
            showStoreField={true}
            note="One report, then The Ad-Waste Report each week. Unsubscribe any time."
          />
        </div>
      </div>
    </div>
  </section>
</Layout>

<script define:vars={{ questions, totalPoints }}>
  function initScorecard() {
    const scoreBtn = document.getElementById('score-btn');
    const results = document.getElementById('results');
    if (!scoreBtn) return;

    function money(v) { return '$' + Math.round(v).toLocaleString('en-US'); }

    scoreBtn.addEventListener('click', () => {
      const gmv = Math.max(0, parseFloat(document.getElementById('gmv-input').value) || 0);
      const cbRate = Math.max(0, parseFloat(document.getElementById('cb-rate-input').value) || 0);
      const aov = Math.max(0, parseFloat(document.getElementById('aov-input').value) || 0);

      let score = 0;
      const flagged = [];

      questions.forEach((q) => {
        const card = document.querySelector('[data-qid="' + q.id + '"]');
        const checked = card ? card.querySelector('input:checked') : null;
        const idx = checked ? parseInt(checked.value, 10) : 0;
        const opt = q.options[idx] || q.options[0];
        score += opt.score;
        if (opt.score > 0) {
          flagged.push({
            q: q.q,
            label: opt.label,
            fix: opt.fix,
            points: opt.score,
            max: Math.max.apply(null, q.options.map(function (o) { return o.score; }))
          });
        }
      });

      const ratio = totalPoints > 0 ? score / totalPoints : 0;
      const scoreEl = document.getElementById('score-value');
      const tierEl = document.getElementById('score-tier');
      const verdictEl = document.getElementById('score-verdict');

      scoreEl.textContent = score;
      scoreEl.className = 'text-6xl font-black font-mono tracking-tight ' + (ratio >= 0.66 ? 'text-rose-400' : ratio >= 0.4 ? 'text-orange-400' : ratio >= 0.2 ? 'text-amber-400' : 'text-emerald-400');

      let tier, tierClass, verdict;
      if (ratio >= 0.66) {
        tier = 'Critical Exposure';
        tierClass = 'bg-rose-500/10 text-rose-300 border border-rose-500/30';
        verdict = 'Your dispute drivers are structural, not incidental. At this rate you are on a card-network watch list, and the defence you are relying on — your own product listing — is the thing being used against you. Fix fulfilment truth and delivery promise first; the rest is noise until those are solid.';
      } else if (ratio >= 0.4) {
        tier = 'Elevated Exposure';
        tierClass = 'bg-orange-500/10 text-orange-300 border border-orange-500/30';
        verdict = 'You are leaking revenue to disputes on a predictable basis. The good news: at least one of your answers points at a fix that is days of work, not months. The bad news: every month you wait, the processor fees and the lost good customers compound.';
      } else if (ratio >= 0.2) {
        tier = 'Moderate Exposure';
        tierClass = 'bg-amber-500/10 text-amber-300 border border-amber-500/30';
        verdict = 'Your fundamentals are sound and your remaining risk is concentrated in one or two places. Find them below, fix them, and your dispute rate should drop into the sub-0.2% range that processors consider healthy.';
      } else {
        tier = 'Healthy Operation';
        tierClass = 'bg-emerald-500/10 text-emerald-300 border border-emerald-500/30';
        verdict = 'Your seller health is in good shape — you are defending disputes and honouring your promises. Keep the evidence pack current and re-run this scorecard quarterly, because fulfilment drift is what moves brands out of this tier, not new competitors.';
      }

      tierEl.textContent = tier;
      tierEl.className = 'inline-block px-4 py-1.5 rounded-full text-xs font-bold ' + tierClass;
      verdictEl.textContent = verdict;

      // Financial exposure
      const annualRevenue = gmv * 12;
      const disputesPerYear = Math.round((annualRevenue / Math.max(aov, 1)) * (cbRate / 100));
      const exposure = annualRevenue * (cbRate / 100);
      const recoverable = annualRevenue * Math.max(0, (cbRate - 0.1) / 100);
      document.getElementById('metric-exposure').textContent = money(exposure);
      document.getElementById('metric-recoverable').textContent = money(recoverable);
      document.getElementById('metric-disputes').textContent = disputesPerYear.toLocaleString('en-US');

      // Fix queue
      flagged.sort(function (a, b) { return (b.points / b.max) - (a.points / a.max); });
      const fixList = document.getElementById('fix-list');
      if (flagged.length === 0) {
        fixList.innerHTML = '<div class="p-4 rounded-xl bg-emerald-950/40 border border-emerald-500/20 text-xs text-emerald-200">No red flags. Every question passed — keep the evidence pack current and re-run this quarterly.</div>';
      } else {
        fixList.innerHTML = flagged.map(function (f, i) {
          const severity = (f.points / f.max) >= 0.8 ? 'Critical' : (f.points / f.max) >= 0.5 ? 'High' : 'Moderate';
          const sevClass = severity === 'Critical' ? 'bg-rose-500/10 text-rose-400 border-rose-500/30' : severity === 'High' ? 'bg-orange-500/10 text-orange-400 border border-orange-500/30' : 'bg-amber-500/10 text-amber-400 border border-amber-500/30';
          return '<div class="p-4 rounded-xl bg-slate-950 border border-slate-800/80">' +
            '<div class="flex items-start justify-between gap-3 mb-1.5">' +
            '<strong class="text-white text-xs leading-snug">' + (i + 1) + '. ' + f.q + '</strong>' +
            '<span class="shrink-0 text-[10px] px-2 py-0.5 rounded-full font-mono border ' + sevClass + '">' + severity + '</span>' +
            '</div>' +
            '<div class="text-[11px] text-slate-500 mb-2">Your answer: ' + f.label + '</div>' +
            '<div class="text-xs text-blue-300 leading-relaxed"><strong class="text-blue-400">Fix:</strong> ' + f.fix + '</div>' +
            '</div>';
        }).join('');
      }

      results.classList.remove('hidden');
      results.scrollIntoView({ behavior: 'smooth', block: 'start' });

      if (typeof window.trackEvent === 'function') {
        window.trackEvent('chargeback_scorecard_completed', { score: score, tier: tier, flags: flagged.length });
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initScorecard);
  } else {
    initScorecard();
  }
</script>
