---
import Layout from '../layouts/Layout.astro';

interface Tier {
  id: string;
  index: string;
  name: string;
  price: string;
  priceNote: string;
  duration: string;
  bestFor: string;
  includes: string[];
  featured?: boolean;
}

const tiers: Tier[] = [
  {
    id: 'audit',
    index: '01',
    name: 'Architecture Audit',
    price: '$1,500 – $3,500',
    priceNote: 'one-time, fixed scope',
    duration: '2–3 days',
    bestFor: 'Brands that suspect they are leaking money but do not know where.',
    includes: [
      'Forensic teardown of storefront, tracking and retention stack',
      'Meta outbound clicks vs GA4 landing page views reconciliation',
      'Mobile CWV field-data audit (LCP / INP / CLS at p75)',
      'Klaviyo flow, segmentation and deliverability review',
      'Fulfillment-promise vs delivery-reality gap check',
      'Prioritized written report with revenue-weighted fixes',
    ],
  },
  {
    id: 'sprint',
    index: '02',
    name: 'Conversion Sprint',
    price: '$5,000 – $12,000',
    priceNote: 'one-time, fixed scope',
    duration: '4–6 weeks',
    bestFor: 'Brands ready to ship fixes, not just receive a document.',
    featured: true,
    includes: [
      'Everything in the Architecture Audit, re-run as a live baseline',
      'Implementation of the 3–5 highest-impact changes, in your theme',
      'Liquid / JS / CSS written and shipped to staging first',
      'Ad landing page or direct-to-checkout flow rebuild',
      'Before / after measurement on CVR, revenue per session and CWV',
      'Loom walkthrough plus written handover documentation',
    ],
  },
  {
    id: 'retainer',
    index: '03',
    name: 'Growth Retainer',
    price: '$3,000 – $8,000',
    priceNote: 'per month, 30 days notice',
    duration: 'Ongoing, quarterly roadmap',
    bestFor: 'Teams that need a senior operator in the loop every month.',
    includes: [
      'Monthly testing roadmap tied to revenue, not vibes',
      'Continuous CRO and performance maintenance',
      'Klaviyo flow expansion and lifecycle program ownership',
      'Ad landing page and creative-direction iteration',
      'Weekly reporting on traffic, funnel and retention',
      'Direct access — no account manager, no ticket queue',
    ],
  },
  {
    id: 'white-label',
    index: '04',
    name: 'White-Label Partnership',
    price: 'Scoped per agency',
    priceNote: 'agency rate card',
    duration: 'Per project or ongoing',
    bestFor: 'Agencies and in-house teams that need senior CRO capacity.',
    includes: [
      'Audit and implementation delivered in your brand and your deck',
      'No client-facing contact from me — you stay the relationship owner',
      'Senior CRO, performance and Klaviyo capacity without headcount',
      'Conflict-free, with a simple monthly rate card',
      'Your client reporting template, your SLA',
    ],
  },
];

const process = [
  {
    stage: 'Stage 01',
    title: 'Audit & Baseline',
    duration: '2–3 days',
    detail: 'Forensic teardown of storefront, ad tracking, retention and fulfillment. We agree the baseline together before a single line changes — conversion rate, revenue per session, p75 field CWV, click-loss rate.',
  },
  {
    stage: 'Stage 02',
    title: 'Prioritized Roadmap',
    duration: 'Day 3 – 4',
    detail: 'A ranked list of fixes scored by revenue impact against effort, not a 50-slide deck. You see exactly what ships in the sprint and what waits.',
  },
  {
    stage: 'Stage 03',
    title: 'Implementation & Traffic Switch',
    duration: '4–6 weeks',
    detail: 'The highest-impact changes are written into a duplicate theme or staging environment, reviewed against CWV and conversion impact, then shipped with zero downtime.',
  },
  {
    stage: 'Stage 04',
    title: 'Retention & Health Defense',
    duration: 'Ongoing',
    detail: 'Klaviyo lifecycle flows, fulfillment-truth auditing and multi-language consistency checks run continuously to protect LTV, reputation and payment processing health.',
  },
];

const notFit = [
  {
    title: 'Under roughly $50k/month in revenue',
    detail: 'The fee becomes a material percentage of margin. A free Shopify theme plus one focused CRO session usually outperforms what I would charge.',
  },
  {
    title: 'Single-SKU dropshipping or gray-market resale',
    detail: 'There is no long-term customer relationship to protect and no brand premium to defend. The economics do not support this kind of work.',
  },
  {
    title: 'Looking for a guaranteed conversion lift',
    detail: 'Anyone promising a month-one lift is describing seasonality. I can promise process, measurement and a documented baseline — not a number I do not control.',
  },
  {
    title: 'You need someone to make the decisions for you',
    detail: 'This is advisory plus implementation, not a managed department. I need a decision-maker on your side who can approve changes inside a sprint.',
  },
];
---

<Layout
  title="Engagement Tiers & Pricing — DTC Architecture, CRO & Klaviyo Advisory | Naif"
  description="Transparent engagement ranges for DTC architecture audits, conversion sprints, growth retainers and white-label agency work. Fixed scope, written quote, no hourly billing."
>
  <!-- Breadcrumb -->
  <div class="border-b border-slate-800 bg-slate-900/60 py-3">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-xs text-slate-400">
        <a href="/" class="hover:text-blue-400 transition-colors">Home</a>
        <span>/</span>
        <span class="text-blue-400">Advisory</span>
        <span>/</span>
        <span class="text-slate-200">Engagement Tiers</span>
      </nav>
    </div>
  </div>

  <!-- Header -->
  <section class="py-14 sm:py-20 bg-slate-950 border-b border-slate-800 relative overflow-hidden">
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#1e293b0a_1px,transparent_1px),linear-gradient(to_bottom,#1e293b0a_1px,transparent_1px)] bg-[size:32px_32px]"></div>
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[650px] h-[280px] bg-blue-600/10 rounded-full blur-[130px] pointer-events-none"></div>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/20 text-xs font-semibold text-blue-400 mb-5">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>Fixed Scope · Written Quote · No Hourly Billing</span>
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight leading-tight mb-5">
        Four Ways to <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-indigo-300 to-sky-300">Work Together</span>
      </h1>
      <p class="text-sm sm:text-base text-slate-300 leading-relaxed max-w-2xl mx-auto">
        Indicative ranges so you can self-qualify before we ever speak. Every engagement is quoted in writing with a fixed scope and a fixed price — if the scope changes, you approve the change first.
      </p>
    </div>
  </section>

  <!-- Tier Cards -->
  <section class="py-16 sm:py-20 bg-slate-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        {tiers.map((t) => (
          <div
            class={`relative flex flex-col rounded-2xl p-6 sm:p-8 border transition-colors ${
              t.featured
                ? 'bg-gradient-to-br from-blue-950/40 to-slate-900 border-blue-500/40 shadow-xl shadow-blue-600/10'
                : 'bg-slate-900 border-slate-800 hover:border-slate-700'
            }`}
          >
            {t.featured && (
              <span class="absolute -top-3 left-6 px-3 py-1 rounded-full bg-blue-600 text-white text-[10px] font-bold uppercase tracking-wider">
                Most Common
              </span>
            )}

            <div class="flex items-start justify-between gap-4 mb-5">
              <div class="flex items-center gap-3.5">
                <span class="w-11 h-11 rounded-xl bg-blue-600/10 text-blue-400 border border-blue-500/20 flex items-center justify-center font-mono text-sm font-bold">
                  {t.index}
                </span>
                <div>
                  <h2 class="text-lg font-bold text-white tracking-tight">{t.name}</h2>
                  <div class="text-[11px] text-slate-500 font-mono mt-0.5">{t.duration}</div>
                </div>
              </div>
            </div>

            <div class="flex items-baseline gap-2 mb-1">
              <span class="text-2xl sm:text-3xl font-black text-white tracking-tight">{t.price}</span>
            </div>
            <div class="text-[11px] text-slate-500 font-mono mb-5">{t.priceNote}</div>

            <p class="text-xs text-slate-300 leading-relaxed mb-5 italic">“{t.bestFor}”</p>

            <ul class="space-y-2.5 mb-7">
              {t.includes.map((inc) => (
                <li class="flex items-start gap-2.5 text-xs text-slate-400 leading-relaxed">
                  <svg class="w-4 h-4 text-blue-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>{inc}</span>
                </li>
              ))}
            </ul>

            <a
              href={`/contact?project=${encodeURIComponent(t.name)}#rfq`}
              class={`mt-auto text-center py-3 rounded-xl text-xs sm:text-sm font-semibold transition-all hover:-translate-y-0.5 ${
                t.featured
                  ? 'bg-blue-600 hover:bg-blue-500 text-white shadow-lg shadow-blue-600/30'
                  : 'bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700'
              }`}
            >
              Request {t.name}
            </a>
          </div>
        ))}
      </div>

      <p class="text-[11px] text-slate-500 leading-relaxed mt-6 text-center">
        Ranges reflect typical scope for brands in the $50k–$2M/month band. Final quotes are fixed-scope and written before work begins.
        Payment terms: 50% to schedule, 50% on delivery for fixed-scope work; retainers billed monthly in advance.
      </p>
    </div>
  </section>

  <!-- Process -->
  <section class="py-16 sm:py-24 bg-slate-900 border-t border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-14">
        <div class="text-xs uppercase tracking-wider text-blue-400 font-semibold mb-2">How The Engagement Runs</div>
        <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">A Predictable, Data-Driven Process</h2>
        <p class="text-xs sm:text-sm text-slate-400 mt-3 leading-relaxed">
          The same four stages on every engagement — from a single audit to a full-scope advisory contract.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {process.map((p, i) => (
          <div class="relative bg-slate-950 border border-slate-800 rounded-2xl p-6">
            <div class="flex items-center justify-between mb-4">
              <span class="text-[11px] font-mono text-blue-400 font-semibold uppercase tracking-wider">{p.stage}</span>
              <span class="text-[11px] text-slate-500 font-mono">{p.duration}</span>
            </div>
            <h3 class="text-base font-bold text-white mb-2.5">{p.title}</h3>
            <p class="text-xs text-slate-400 leading-relaxed">{p.detail}</p>
            {i < process.length - 1 && (
              <div class="hidden lg:block absolute -right-3 top-1/2 -translate-y-1/2 text-slate-700 text-xl">→</div>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Not A Fit -->
  <section class="py-16 sm:py-24 bg-slate-950 border-t border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
        <div class="lg:col-span-4">
          <div class="text-xs uppercase tracking-wider text-rose-400 font-semibold mb-2">Before You Hire Me</div>
          <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight leading-tight mb-4">
            When I am the <span class="text-rose-400">wrong</span> fit
          </h2>
          <p class="text-xs sm:text-sm text-slate-400 leading-relaxed">
            The most expensive thing I can do is take a job I cannot make work. These are the situations where I will point you somewhere else — and I will say so on the first call.
          </p>
        </div>

        <div class="lg:col-span-8 grid grid-cols-1 sm:grid-cols-2 gap-5">
          {notFit.map((n) => (
            <div class="bg-slate-900 border border-slate-800 rounded-xl p-5 sm:p-6">
              <div class="flex items-start gap-3">
                <span class="shrink-0 w-6 h-6 rounded-md bg-rose-500/10 border border-rose-500/20 text-rose-400 flex items-center justify-center text-xs font-bold mt-0.5">
                  ✕
                </span>
                <div>
                  <h3 class="text-sm font-bold text-white mb-1.5 leading-snug">{n.title}</h3>
                  <p class="text-xs text-slate-400 leading-relaxed">{n.detail}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 sm:py-20 bg-slate-900 border-t border-slate-800">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight mb-3">Start With the Cheapest Honest Answer</h2>
      <p class="text-xs sm:text-sm text-slate-400 leading-relaxed mb-7">
        Run the free diagnostics below, or send your store URL and I will tell you which tier actually fits — even if the answer is “none of them yet”.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a
          href="/tools/click-loss-auditor"
          class="px-6 py-3.5 rounded-xl font-semibold text-sm bg-blue-600 hover:bg-blue-500 text-white shadow-lg shadow-blue-600/30 transition-all hover:-translate-y-0.5"
        >
          Run Click-Loss Audit
        </a>
        <a
          href="/faq"
          class="px-6 py-3.5 rounded-xl font-semibold text-sm bg-slate-950 hover:bg-slate-900 text-slate-200 border border-slate-800 transition-colors"
        >
          Read All FAQs
        </a>
      </div>
    </div>
  </section>
</Layout>
