---
import Layout from '../layouts/Layout.astro';
import RfqForm from '../components/RfqForm.astro';

const skuParam = Astro.url.searchParams.get('sku') || '';
---

<Layout
  title="Contact Sales & Factory Engineering | Apex Precision"
  description="Contact our technical sales team for custom B2B manufacturing, OEM/ODM RFQs, and factory visit scheduling. Fast reply within 24 hours."
>
  <div class="py-12 sm:py-16 bg-slate-900 border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-xs uppercase tracking-wider text-blue-400 font-semibold mb-2">Global Customer Support</div>
      <h1 class="text-3xl sm:text-4xl font-black text-white tracking-tight">Contact Sales & Engineering</h1>
      <p class="text-sm text-slate-400 mt-2 max-w-2xl">
        Whether you require a single prototype or high-volume recurring production, our application engineers provide complete DFM consultation and quotation.
      </p>
    </div>
  </div>

  <div class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      <!-- Left Info Column (5 cols) -->
      <div class="lg:col-span-5 space-y-8">
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 sm:p-8 space-y-6">
          <h3 class="text-lg font-bold text-white tracking-tight">Direct Sales Office</h3>

          <div class="space-y-4 text-xs sm:text-sm">
            <div>
              <span class="text-slate-500 block mb-1">Official Inquiry Email:</span>
              <a href="mailto:sales@apexprecision.com" class="text-blue-400 hover:underline font-medium text-base">
                sales@apexprecision.com
              </a>
            </div>

            <div>
              <span class="text-slate-500 block mb-1">WhatsApp / Direct Line:</span>
              <span class="text-slate-200 font-medium text-base">+852 9876 5432</span>
            </div>

            <div>
              <span class="text-slate-500 block mb-1">Manufacturing Plant & HQ:</span>
              <p class="text-slate-300 leading-relaxed">
                Building 4, Apex High-Tech Advanced Manufacturing Park, Industrial Zone B, Hong Kong & Greater Bay Area
              </p>
            </div>

            <div>
              <span class="text-slate-500 block mb-1">Operating Hours:</span>
              <p class="text-slate-300">
                Monday – Friday: 08:30 – 18:30 (GMT+8)<br />
                <span class="text-blue-400">Emergency RFQ Hotline: 24/7 on WhatsApp</span>
              </p>
            </div>
          </div>
        </div>

        <!-- Factory Audit Notice -->
        <div class="bg-blue-950/30 border border-blue-500/20 rounded-2xl p-6">
          <h4 class="text-sm font-bold text-white mb-2 flex items-center gap-2">
            <span>🏭 Factory Audits Welcome</span>
          </h4>
          <p class="text-xs text-slate-300 leading-relaxed">
            We welcome third-party audits by SGS, TÜV, or your internal procurement engineering team. Video audit tours via Zoom or Teams are available upon request.
          </p>
        </div>
      </div>

      <!-- Right Form Column (7 cols) -->
      <div class="lg:col-span-7" id="rfq">
        <RfqForm presetSku={skuParam} />
      </div>
    </div>
  </div>
</Layout>
