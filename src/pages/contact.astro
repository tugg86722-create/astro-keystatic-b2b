---
import Layout from '../layouts/Layout.astro';
import RfqForm from '../components/RfqForm.astro';

const projectParam = Astro.url.searchParams.get('project') || Astro.url.searchParams.get('sku') || '';
---

<Layout
  title="Work With Me | DTC Architecture & Growth Advisory | Naif"
  description="Contact Naif for high-ticket DTC Shopify/Jamstack storefront architecture, Meta ad landing page CRO, Klaviyo retention systems, and growth advisory."
>
  <div class="py-12 sm:py-16 bg-slate-900 border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-xs uppercase tracking-wider text-blue-400 font-semibold mb-2">DTC Growth Engagement & Contracts</div>
      <h1 class="text-3xl sm:text-4xl font-black text-white tracking-tight">Work With Me / DTC Architecture & Advisory</h1>
      <p class="text-sm text-slate-400 mt-2 max-w-2xl">
        I partner with high-ticket DTC brands, luxury ecommerce founders, and scaling cross-border operators to build high-converting storefronts, eliminate ad leakage, and protect seller health.
      </p>
    </div>
  </div>

  <div class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      <!-- Left Info Column (5 cols) -->
      <div class="lg:col-span-5 space-y-8">
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 sm:p-8 space-y-6">
          <h3 class="text-lg font-bold text-white tracking-tight">Direct Channels</h3>

          <div class="space-y-4 text-xs sm:text-sm">
            <div>
              <span class="text-slate-500 block mb-1">Work Email:</span>
              <a href="mailto:dewellsmell@gmail.com" class="text-blue-400 hover:underline font-medium text-base">
                dewellsmell@gmail.com
              </a>
            </div>

            <div>
              <span class="text-slate-500 block mb-1">GitHub Profile:</span>
              <a href="https://github.com/tugg86722-create" target="_blank" rel="noreferrer" class="text-slate-200 hover:text-blue-400 transition-colors font-medium text-base">
                github.com/tugg86722-create
              </a>
            </div>

            <div>
              <span class="text-slate-500 block mb-1">Availability & Timezones:</span>
              <p class="text-slate-300 leading-relaxed">
                Open for DTC architecture audits, conversion sprints, and growth advisory contracts. Flexible overlap with US, European, and APAC brand teams.
              </p>
            </div>
          </div>
        </div>

        <!-- Scope of Work Notice -->
        <div class="bg-blue-950/30 border border-blue-500/20 rounded-2xl p-6">
          <h4 class="text-sm font-bold text-white mb-2 flex items-center gap-2">
            <span>🛠️ Core Engagement Offerings</span>
          </h4>
          <ul class="text-xs text-slate-300 space-y-2 leading-relaxed">
            <li class="flex items-start gap-1.5">
              <span class="text-blue-400 font-bold">•</span>
              <span><strong>High-Ticket Storefront Architecture</strong>: Custom Shopify OS2.0 & Jamstack builds with 6-shot anti-slop visual direction.</span>
            </li>
            <li class="flex items-start gap-1.5">
              <span class="text-blue-400 font-bold">•</span>
              <span><strong>Meta/Google Ad Landing Page CRO</strong>: Slashing mobile click-to-landing loss from 25%+ down to &lt; 8%.</span>
            </li>
            <li class="flex items-start gap-1.5">
              <span class="text-blue-400 font-bold">•</span>
              <span><strong>Klaviyo Lifecycle Retention</strong>: High-converting welcome sequences, browse abandonment, and VIP retention.</span>
            </li>
            <li class="flex items-start gap-1.5">
              <span class="text-blue-400 font-bold">•</span>
              <span><strong>Fulfillment Truth & Chargeback Shield</strong>: Preempting PayPal & Stripe disputes by aligning digital claims with physical parcel delivery.</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Right Form Column (7 cols) -->
      <div class="lg:col-span-7" id="rfq">
        <RfqForm presetSku={projectParam} />
      </div>
    </div>
  </div>
</Layout>
